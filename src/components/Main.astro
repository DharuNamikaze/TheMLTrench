<script is:inline type="module">
  import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.module.js";

  // Add canvas styling to prevent distortion
  const style = document.createElement('style');
  style.textContent = `
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
    canvas {
      display: block;
      width: 100vw !important;
      height: 100vh !important;
      position: fixed;
      top: 0;
      left: 0;
    }
  `;
  document.head.appendChild(style);

  // ===============================
  // 0️⃣ CROSSHAIR SETUP
  // ===============================
  const crosshair = document.createElement('div');
  crosshair.id = 'crosshair';
  crosshair.style.cssText = `
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 30px;
    height: 30px;
    border: 2px solid rgba(135, 206, 235, 0.8);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1000;
    transition: border-color 0.2s;
  `;
  
  const crosshairDot = document.createElement('div');
  crosshairDot.style.cssText = `
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 4px;
    height: 4px;
    background: rgba(135, 206, 235, 0.8);
    border-radius: 50%;
  `;
  crosshair.appendChild(crosshairDot);
  document.body.appendChild(crosshair);

  // ===============================
  // 1️⃣ SCENE SETUP
  // ===============================
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x000000);

  const camera = new THREE.PerspectiveCamera(
    60,  // Reduced FOV from 75 to 60 to reduce distortion
    window.innerWidth / window.innerHeight,
    0.1,
    5000,
  );
  camera.position.set(0, 0, 100);

  const renderer = new THREE.WebGLRenderer({ 
    antialias: true,
    alpha: false,
    powerPreference: "high-performance"
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(window.devicePixelRatio);
  document.body.appendChild(renderer.domElement);

  // ===============================
  // 2️⃣ CLUSTER COLORS (10 clusters × 100 spheres = 1000 total)
  // ===============================
  const clusterColors = [
    0x4fc3f7, // Cyan
    0xff6b9d, // Pink
    0x00ff88, // Green
    0xffd700, // Gold
    0xff4500, // Orange Red
    0x9370db, // Purple
    0x00ced1, // Dark Turquoise
    0xff1493, // Deep Pink
    0x7fff00, // Chartreuse
    0xff00ff, // Magenta
  ];

  // ===============================
  // 3️⃣ CREATE GLOWING SPHERES WITH CLUSTERS
  // ===============================
  const spheres = [];
  const glowSprites = [];
  const geometry = new THREE.SphereGeometry(8, 16, 16);

  // Create glow texture for sprites
  const canvas = document.createElement('canvas');
  canvas.width = 128;
  canvas.height = 128;
  const ctx = canvas.getContext('2d');
  const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
  gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
  gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
  gradient.addColorStop(0.4, 'rgba(255, 255, 255, 0.4)');
  gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, 128, 128);
  const glowTexture = new THREE.CanvasTexture(canvas);

  // Create 10 clusters of 100 spheres each
  for (let clusterIndex = 0; clusterIndex < 10; clusterIndex++) {
    const clusterColor = clusterColors[clusterIndex];
    
    // Random cluster center in free space
    const clusterCenter = new THREE.Vector3(
      (Math.random() - 0.5) * 2000,
      (Math.random() - 0.5) * 2000,
      (Math.random() - 0.5) * 2000
    );

    for (let i = 0; i < 100; i++) {
      // Create sphere
      const material = new THREE.MeshBasicMaterial({
        color: clusterColor,
        transparent: true,
        opacity: 0.9,
        size:50,
      });

      const sphere = new THREE.Mesh(geometry, material);

      // Position within cluster (spherical distribution around cluster center)
      const radius = Math.random() * 500 + 50; // 50-350 units from center
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);

      sphere.position.set(
        clusterCenter.x + radius * Math.sin(phi) * Math.cos(theta),
        clusterCenter.y + radius * Math.sin(phi) * Math.sin(theta),
        clusterCenter.z + radius * Math.cos(phi)
      );

      // Add glow sprite
      const spriteMaterial = new THREE.SpriteMaterial({
        map: glowTexture,
        color: clusterColor,
        transparent: true,
        blending: THREE.AdditiveBlending,
        opacity: 0.6,
      });
      const sprite = new THREE.Sprite(spriteMaterial);
      sprite.scale.set(40, 40, 1);
      sprite.position.copy(sphere.position);
      scene.add(sprite);
      glowSprites.push(sprite);

      // Metadata
      sphere.userData = {
        title: `Cluster ${clusterIndex + 1} - Concept ${i + 1}`,
        description: `A concept in cluster ${clusterIndex + 1}`,
        cluster: clusterIndex,
        originalColor: clusterColor,
        glowSprite: sprite
      };

      scene.add(sphere);
      spheres.push(sphere);
    }
  }

  console.log(`✅ Created ${spheres.length} spheres in 10 clusters`);

  // ===============================
  // 4️⃣ MINIMAL LIGHTING
  // ===============================
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.2);
  scene.add(ambientLight);

  // ===============================
  // 5️⃣ FREE-LOOK CAMERA WITH POINTER LOCK (NO SMOOTHING)
  // ===============================
  let rotationX = 0;
  let rotationY = 0;
  let isLocked = false;

  // Click to lock pointer
  document.body.addEventListener("click", () => {
    document.body.requestPointerLock();
  });

  document.addEventListener("pointerlockchange", () => {
    isLocked = document.pointerLockElement === document.body;
  });

  // Mouse move for free look (instant, no smoothing)
  document.addEventListener("mousemove", (e) => {
    if (!isLocked) return;
    
    // Direct rotation control (no smoothing)
    rotationY -= e.movementX * 0.002;
    rotationX -= e.movementY * 0.002;
    
    // Clamp vertical rotation to prevent flipping
    rotationX = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, rotationX));
    
    // Apply rotation using proper Euler order to prevent gimbal lock
    camera.rotation.order = 'YXZ';
    camera.rotation.y = rotationY;
    camera.rotation.x = rotationX;
  });

  // ESC to exit pointer lock
  window.addEventListener("keydown", (e) => {
    if (e.code === "Escape") {
      document.exitPointerLock();
    }
  });

  // ===============================
  // 6️⃣ KEYBOARD MOVEMENT
  // ===============================
  const keys = {};
  let speed = 16;
  let isBoosting = false;

  window.addEventListener("keydown", (e) => {
    keys[e.code] = true;
    if (e.code === "ShiftLeft") isBoosting = true;
  });

  window.addEventListener("keyup", (e) => {
    keys[e.code] = false;
    if (e.code === "ShiftLeft") isBoosting = false;
  });

  function movePlayer() {
    const move = new THREE.Vector3();
    const forward = new THREE.Vector3(0, 0, -1);
    const right = new THREE.Vector3(1, 0, 0);
    
    // Apply camera rotation to movement vectors
    forward.applyQuaternion(camera.quaternion);
    right.applyQuaternion(camera.quaternion);

    if (keys["KeyW"]) move.add(forward);
    if (keys["KeyS"]) move.sub(forward);
    if (keys["KeyD"]) move.add(right);
    if (keys["KeyA"]) move.sub(right);

    move.normalize();

    const currentSpeed = isBoosting ? speed * 2 : speed;
    camera.position.addScaledVector(move, currentSpeed);
  }

  // ===============================
  // 7️⃣ RAYCAST INTERACTION WITH 2D RING
  // ===============================
  const raycaster = new THREE.Raycaster();
  raycaster.far = 500;
  let hovered = null;
  let halo = null;

  const centerMouse = new THREE.Vector2(0, 0);
  
  // Create 2D ring geometry that always faces camera
  const haloGeometry = new THREE.RingGeometry(15, 20, 32);

  function handleHover() {
    raycaster.setFromCamera(centerMouse, camera);
    const hits = raycaster.intersectObjects(spheres);

    // Reset previous hover
    if (hovered) {
      hovered.material.color.setHex(hovered.userData.originalColor);
      hovered.material.opacity = 0.9;
      hovered.scale.set(1, 1, 1);
      hovered.userData.glowSprite.material.opacity = 0.6;
      hovered = null;
      
      // Remove halo
      if (halo) {
        scene.remove(halo);
        halo = null;
      }
    }

    // Apply new hover
    if (hits.length > 0) {
      hovered = hits[0].object;

      // Brighten sphere
      hovered.material.color.set(0xffffff);
      hovered.material.opacity = 1.0;
      hovered.scale.set(1.3, 1.3, 1.3);
      hovered.userData.glowSprite.material.opacity = 1.0;

      crosshair.style.borderColor = 'rgba(255, 255, 255, 1)';
      crosshairDot.style.background = 'rgba(255, 255, 255, 1)';
      
      // Create 2D ring that faces camera
      const haloMaterial = new THREE.MeshBasicMaterial({
        color: hovered.userData.originalColor,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.8,
      });
      
      halo = new THREE.Mesh(haloGeometry, haloMaterial);
      halo.position.copy(hovered.position);
      halo.lookAt(camera.position); // Always face camera (2D effect)
      scene.add(halo);
      
      console.log(`Hovering: ${hovered.userData.title}`);
    } else {
      crosshair.style.borderColor = 'rgba(135, 206, 235, 0.8)';
      crosshairDot.style.background = 'rgba(135, 206, 235, 0.8)';
    }
  }

  // ===============================
  // 8️⃣ SPHERE PULSE ANIMATION
  // ===============================
  function animateSpheres() {
    const time = Date.now() * 0.005;

    spheres.forEach((sphere, i) => {
      // Skip animation for hovered sphere
      if (hovered === sphere) return;

      // Subtle pulse
      const pulse = 1 + Math.sin(time * 2 + i * 0.1) * 0.05;
      sphere.scale.set(pulse, pulse, pulse);

      // Gentle rotation
      sphere.rotation.y += 0.005;
      
      // Sync glow sprite with sphere
      sphere.userData.glowSprite.position.copy(sphere.position);
    });
    
    // Update halo to always face camera
    if (halo) {
      halo.lookAt(camera.position);
    }
  }

  // ===============================
  // 9️⃣ ANIMATION LOOP
  // ===============================
  function animate() {
    requestAnimationFrame(animate);
    movePlayer();
    handleHover();
    animateSpheres();
    renderer.render(scene, camera);
  }

  animate();

  // ===============================
  // 🔟 RESIZE HANDLER
  // ===============================
  window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>