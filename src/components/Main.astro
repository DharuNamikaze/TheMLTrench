<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Deep ML Space</title>
    <!-- Preload critical font for instant text rendering -->
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/keyboard-css@1.2.4/dist/css/main.min.css"
    />
    <style>
      body {
        margin: 0;
        overflow: hidden;
        background: #000;
        font-family:
          "Inter Variable",
          system-ui,
          -apple-system,
          sans-serif;
      }
      #hud {
        position: fixed;
        top: 10px;
        right: 10px;
        color: #fff;
        z-index: 10;
        font-size: 12px;
      }
      #crosshair {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 30px;
        height: 30px;
        border: 2px solid rgba(255, 255, 235, 1);
        border-radius: 50%;
        pointer-events: none;
        z-index: 100;
      }
      #crosshair::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 4px;
        height: 4px;
        background: #fff;
        border-radius: 50%;
      }
      #info {
        position: fixed;
        top: 20%;
        left: 0;
        right: 0;
        margin: auto;
        color: #fff;
        text-align: center;
        padding: 12px;
        font-size: 18px;
        min-width: 500px;
        display: none;
        z-index: 10;
      }
      #help {
        position: fixed;
        bottom: 20px;
        right: 20px;
        color: #fff;
        cursor: pointer;
        background: rgba(0, 0, 0, 0.7);
        padding: 10px 16px;
        border-radius: 8px;
        z-index: 10;
        font-family: monospace;
        border: 1px solid rgba(135, 206, 235, 0.3);
      }
      #minimap {
        position: fixed;
        bottom: 10px;
        left: 10px;
        z-index: 20;
        border-radius: 50%;
        border: 1px solid rgba(135, 206, 235, 0.4);
        background: rgba(0, 0, 0, 0.6);
        pointer-events: none;
      }
      #modal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.85);
        z-index: 1000;
      }
      #modal.show {
        display: flex;
      }
      .modal-content {
        background: rgba(10, 10, 10, 0.95);
        border: 1px solid rgba(135, 206, 235, 0.4);
        border-radius: 12px;
        padding: 30px 40px;
        color: #fff;
        position: relative;
      }
      .modal-close {
        position: absolute;
        top: 12px;
        right: 16px;
        font-size: 26px;
        background: none;
        border: none;
        color: #87ceeb;
        cursor: pointer;
      }
      #keystroke-display {
        position: fixed;
        bottom: 60px;
        right: 20px;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 5px;
        pointer-events: none;
      }
      .kbc-toast {
        display: flex;
        gap: 4px;
        align-items: center;
        animation: kbc-fade-out 0.25s ease forwards;
      }
      .kbc-toast.kbc-held {
        animation: kbc-pop-in 0.12s cubic-bezier(0.34,1.56,0.64,1) forwards;
      }
      .kbc-toast .kbc-button {
        font-size: 12px;
        min-width: 32px;
        height: 32px;
        padding: 0 10px;
        background: rgba(10, 15, 30, 0.92) !important;
        border-color: rgba(135, 206, 235, 0.7) !important;
        color: #e0f4ff !important;
        box-shadow: 0 4px 0 rgba(135,206,235,0.35), 0 0 12px rgba(135,206,235,0.15) !important;
        text-shadow: 0 0 8px rgba(135,206,235,0.8);
        letter-spacing: 0.05em;
        transition: box-shadow 0.1s;
      }
      .kbc-toast.kbc-held .kbc-button {
        background: rgba(135, 206, 235, 0.15) !important;
        box-shadow: 0 2px 0 rgba(135,206,235,0.35), 0 0 18px rgba(135,206,235,0.3) !important;
        transform: translateY(2px);
      }
      @keyframes kbc-pop-in {
        0%   { opacity: 0; transform: scale(0.75) translateY(6px); }
        100% { opacity: 1; transform: scale(1) translateY(0); }
      }
      @keyframes kbc-fade-out {
        0%   { opacity: 1; transform: scale(1) translateY(0); }
        100% { opacity: 0; transform: scale(0.85) translateY(-4px); }
      }
    </style>
  </head>

  <body>
    <div id="hud"></div>
    <div id="crosshair"></div>
    <div id="info"></div>
    <canvas id="minimap" width="150" height="150"></canvas>
    <div id="keystroke-display"></div>
    <div id="help">? Help</div>
    <div
      class="tit"
      style="position:fixed; top:10px; left:10px; color:#fff; font-size:36px; font-weight:900; z-index:10;"
    >
      DEEP ML SPACE
    </div>

    <div id="modal">
      <div class="modal-content">
        <button class="modal-close">&times;</button>
        <h2>Controls</h2>
        <div style="font-family:monospace; line-height:1.8">
          <div><b>W/A/S/D</b> Move</div>
          <div><b>Mouse</b> Look</div>
          <div><b>Left Click</b> Next concept</div>
          <div><b>Right Click</b> Previous concept</div>
          <div><b>P</b> Toggle performance stats</div>
          <div><b>ESC</b> Exit</div>
        </div>
      </div>
    </div>

    <script>
      import * as THREE from "three";
      import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
      import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
      import { UnrealBloomPass } from "three/examples/jsm/postprocessing/UnrealBloomPass.js";
      import { mlConcepts, zones } from "../../data/mlconcepts.js";

      // ===== CONFIG =====
      const CONFIG = {
        world: {
          spheresPerConcept: 1,
          chunkSize: 5000,
          renderDistance: 12000,
          minClusterDistance: 200,
          sphereRadiusBase: 800,
          depthScaleMin: 0.3,
          maxDepth: 14000,
        },
        lod: {
          high: { distance: 900, segments: 16 },
          mid: { distance: 3500, segments: 12 },
          low: { distance: Infinity, segments: 10 },
        },
        performance: {
          targetFPS: 60,
          enableBloom: true,
          bloomFPSThreshold: 30,
          raycastInterval: 3,
          enableFrustumCulling: true,
          distanceBasedUpdates: true,
        },
        camera: {
          walkSpeed: 400,
          sprintMultiplier: 6,
          animationDuration: 1200,
        },
      };

      const SPHERES_PER_CONCEPT = CONFIG.world.spheresPerConcept;
      const CHUNK_SIZE = CONFIG.world.chunkSize;
      const RENDER_DIST = CONFIG.world.renderDistance;

      // ===== SCENE =====
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x000000);

      const camera = new THREE.PerspectiveCamera(
        60,
        innerWidth / innerHeight,
        1,
        RENDER_DIST,
      );
      camera.position.set(0, 0, 300);

      const renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setSize(innerWidth, innerHeight);
      renderer.setPixelRatio(Math.min(devicePixelRatio, 1.5));
      document.body.appendChild(renderer.domElement);

      // ===== POST =====
      const composer = new EffectComposer(renderer);
      composer.addPass(new RenderPass(scene, camera));
      composer.addPass(
        new UnrealBloomPass(
          new THREE.Vector2(innerWidth, innerHeight),
          1.0,
          0.5,
          0.2,
        ),
      );

      // ===== UI =====
      const hud = document.getElementById("hud")!;
      const info = document.getElementById("info")!;
      const help = document.getElementById("help")!;
      const modal = document.getElementById("modal")!;
      const modalClose = document.querySelector(".modal-close")!;

      // ===== MINIMAP =====
      const minimapCanvas = document.getElementById(
        "minimap",
      ) as HTMLCanvasElement;
      const mmCtx = minimapCanvas.getContext("2d")!;
      const MM_SIZE = 150;
      const MM_RADIUS = MM_SIZE / 2;
      // World radius to show on minimap (matches sphereRadiusBase max)
      const MM_WORLD_RADIUS = CONFIG.world.sphereRadiusBase * 1.1;

      function worldToMinimap(wx: number, wz: number): [number, number] {
        const x = MM_RADIUS + (wx / MM_WORLD_RADIUS) * MM_RADIUS * 0.9;
        const y = MM_RADIUS + (wz / MM_WORLD_RADIUS) * MM_RADIUS * 0.9;
        return [x, y];
      }

      function drawMinimap() {
        mmCtx.clearRect(0, 0, MM_SIZE, MM_SIZE);

        // Clip to circle
        mmCtx.save();
        mmCtx.beginPath();
        mmCtx.arc(MM_RADIUS, MM_RADIUS, MM_RADIUS - 1, 0, Math.PI * 2);
        mmCtx.clip();

        // Background
        mmCtx.fillStyle = "rgba(0,0,0,0.55)";
        mmCtx.fillRect(0, 0, MM_SIZE, MM_SIZE);

        // Draw cluster dots — only those inside the camera frustum
        frustumMatrix.multiplyMatrices(camera.projectionMatrix, camera.matrixWorldInverse);
        frustum.setFromProjectionMatrix(frustumMatrix);
        for (let i = 0; i < clusters.length; i++) {
          const c = clusters[i];
          if (!frustum.containsPoint(c.center)) continue;
          const [mx, my] = worldToMinimap(c.center.x, c.center.z);
          mmCtx.beginPath();
          mmCtx.arc(mx, my, 1.5, 0, Math.PI * 2);
          mmCtx.fillStyle = `#${c.color.getHexString()}`;
          mmCtx.fill();
        }

        // Camera position dot + direction triangle
        const [cx, cy] = worldToMinimap(camera.position.x, camera.position.z);
        // Get actual forward direction from camera matrix (projected onto XZ plane)
        const fwd = new THREE.Vector3(0, 0, -1).applyQuaternion(
          camera.quaternion,
        );
        // atan2 on XZ gives the heading: fwd.x is right, fwd.z is into screen
        const heading = Math.atan2(fwd.x, -fwd.z);
        const triSize = 5;
        mmCtx.save();
        mmCtx.translate(cx, cy);
        mmCtx.rotate(heading);
        mmCtx.beginPath();
        mmCtx.moveTo(0, -triSize);
        mmCtx.lineTo(triSize * 0.6, triSize * 0.7);
        mmCtx.lineTo(-triSize * 0.6, triSize * 0.7);
        mmCtx.closePath();
        mmCtx.fillStyle = "#fff";
        mmCtx.fill();
        mmCtx.restore();

        mmCtx.restore();

        // Border ring
        mmCtx.beginPath();
        mmCtx.arc(MM_RADIUS, MM_RADIUS, MM_RADIUS - 1, 0, Math.PI * 2);
        mmCtx.strokeStyle = "rgba(135,206,235,0.4)";
        mmCtx.lineWidth = 1;
        mmCtx.stroke();
      }

      // ===== PERFORMANCE STATS =====
      const perfStats = {
        drawCalls: 0,
        triangles: 0,
        visibleSpheres: 0,
        activeChunks: 0,
        memoryUsage: 0,
        frameCount: 0,
      };

      help.onclick = () => modal.classList.add("show");
      modalClose.addEventListener("click", () =>
        modal.classList.remove("show"),
      );
      modal.onclick = (e) => {
        if (e.target === modal) modal.classList.remove("show");
      };

      // disable browser menu for right click
      addEventListener("contextmenu", (e) => e.preventDefault());

      // ===== GLOW TEXTURE =====
      function makeGlowTexture(): THREE.Texture {
        const size = 128;
        const canvas = document.createElement("canvas");
        canvas.width = canvas.height = size;
        const ctx = canvas.getContext("2d")!;
        const grad = ctx.createRadialGradient(
          size / 2, size / 2, 0,
          size / 2, size / 2, size / 2,
        );
        grad.addColorStop(0,   "rgba(255,255,255,1)");
        grad.addColorStop(0.2, "rgba(255,255,255,0.6)");
        grad.addColorStop(0.5, "rgba(255,255,255,0.15)");
        grad.addColorStop(1,   "rgba(255,255,255,0)");
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, size, size);
        return new THREE.CanvasTexture(canvas);
      }
      const glowTexture = makeGlowTexture();

      // ===== GEOMETRY =====
      const GEO = {
        HIGH: new THREE.SphereGeometry(
          9,
          CONFIG.lod.high.segments,
          CONFIG.lod.high.segments,
        ),
        MID: new THREE.SphereGeometry(
          9,
          CONFIG.lod.mid.segments,
          CONFIG.lod.mid.segments,
        ),
        LOW: new THREE.SphereGeometry(
          9,
          CONFIG.lod.low.segments,
          CONFIG.lod.low.segments,
        ),
      };

      // ===== CLUSTERS =====
      const clusters: any[] = [];
      const filteredZones = zones.filter(
        (z: any) => z.name !== "Level 8: The Void",
      );
      const positions: THREE.Vector3[] = [];
      const MIN_DISTANCE = CONFIG.world.minClusterDistance;
      const MIN_DISTANCE_SQ = MIN_DISTANCE * MIN_DISTANCE; // Pre-calculate squared

      const rand = (a: number, b: number) => Math.random() * (b - a) + a;

      // OPTIMIZED: Use squared distance to avoid sqrt
      const isValid = (p: THREE.Vector3) => {
        for (let i = 0; i < positions.length; i++) {
          const dx = p.x - positions[i].x;
          const dy = p.y - positions[i].y;
          const dz = p.z - positions[i].z;
          if (dx * dx + dy * dy + dz * dz < MIN_DISTANCE_SQ) return false;
        }
        return true;
      };

      mlConcepts.forEach((concept: any) => {
        // Validation
        if (!concept || typeof concept.depth !== "number") {
          console.warn("Invalid concept:", concept);
          return;
        }

        const zone = filteredZones.find(
          (z: any) => concept.depth >= z.start && concept.depth < z.end,
        );
        if (!zone) return;

        let center: THREE.Vector3;
        let tries = 0;
        do {
          // Use config constants instead of magic numbers
          const depthRatio = Math.min(concept.depth / CONFIG.world.maxDepth, 1);
          const r =
            CONFIG.world.sphereRadiusBase *
            (CONFIG.world.depthScaleMin +
              depthRatio * (1 - CONFIG.world.depthScaleMin));
          const t = rand(0, Math.PI * 2);
          const p = Math.acos(rand(-1, 1));
          center = new THREE.Vector3(
            r * Math.sin(p) * Math.cos(t),
            r * Math.sin(p) * Math.sin(t),
            r * Math.cos(p),
          );
          tries++;
        } while (!isValid(center) && tries < 50);
        if (!isValid(center)) return;

        positions.push(center);

        const points: THREE.Vector3[] = [];
        for (let i = 0; i < SPHERES_PER_CONCEPT; i++) {
          points.push(
            center
              .clone()
              .add(
                new THREE.Vector3(rand(-30, 30), rand(-30, 30), rand(-30, 30)),
              ),
          );
        }

        clusters.push({
          center,
          color: new THREE.Color(zone.color),
          points,
          navPoint: points[0],
          concept,
        });
      });

      // ===== NAV LIST (SINGLE SOURCE OF TRUTH) =====
      const navigableClusters = clusters
        .filter((c: any) => c.concept)
        .sort((a: any, b: any) => a.concept.depth - b.concept.depth);

      let currentNavIndex = -1;

      // ===== CONNECTION LINES =====
      // Fat smooth tubes per adjacent pair in navigableClusters
      const connLines: { mesh: THREE.Mesh; mat: THREE.MeshBasicMaterial; curve: THREE.CatmullRomCurve3; fromIdx: number; toIdx: number }[] = [];

      for (let i = 0; i < navigableClusters.length - 1; i++) {
        const a = navigableClusters[i].navPoint as THREE.Vector3;
        const b = navigableClusters[i + 1].navPoint as THREE.Vector3;
        const mid = new THREE.Vector3().lerpVectors(a, b, 0.5).addScaledVector(
          new THREE.Vector3().subVectors(b, a).cross(new THREE.Vector3(0,1,0)).normalize(),
          a.distanceTo(b) * 0.08,
        );
        const curve = new THREE.CatmullRomCurve3([a, mid, b]);
        const geo = new THREE.TubeGeometry(curve, 20, 2.5, 8, false);
        const mat = new THREE.MeshBasicMaterial({
          color: 0x87ceeb,
          transparent: true,
          opacity: 0.75,
          depthWrite: false,
        });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.frustumCulled = false;
        mesh.visible = false;
        scene.add(mesh);
        connLines.push({ mesh, mat, curve, fromIdx: i, toIdx: i + 1 });
      }

      // ===== CHUNKING =====
      const chunks = new Map();
      let minX = Infinity,
        minZ = Infinity;

      // OPTIMIZED: Single pass to find min values
      for (let c = 0; c < clusters.length; c++) {
        const points = clusters[c].points;
        for (let p = 0; p < points.length; p++) {
          if (points[p].x < minX) minX = points[p].x;
          if (points[p].z < minZ) minZ = points[p].z;
        }
      }

      // OPTIMIZED: Build chunks in single pass
      for (let ci = 0; ci < clusters.length; ci++) {
        const cluster = clusters[ci];
        const points = cluster.points;
        for (let p = 0; p < points.length; p++) {
          const point = points[p];
          const cx = Math.floor((point.x - minX) / CHUNK_SIZE);
          const cz = Math.floor((point.z - minZ) / CHUNK_SIZE);
          const key = `${cx},${cz}`;

          let chunk = chunks.get(key);
          if (!chunk) {
            chunk = {
              center: new THREE.Vector3(
                minX + (cx + 0.5) * CHUNK_SIZE,
                0,
                minZ + (cz + 0.5) * CHUNK_SIZE,
              ),
              clusters: new Map(),
              current: null,
            };
            chunks.set(key, chunk);
          }

          let clusterPoints = chunk.clusters.get(ci);
          if (!clusterPoints) {
            clusterPoints = [];
            chunk.clusters.set(ci, clusterPoints);
          }
          clusterPoints.push(point);
        }
      }

      // ===== BUILD MESHES =====
      const dummy = new THREE.Object3D();
      const allMeshes: THREE.InstancedMesh[] = [];
      const visibleMeshes: THREE.InstancedMesh[] = [];
      const allMaterials: THREE.MeshStandardMaterial[] = [];
      const allSprites: THREE.Sprite[] = [];

      // OPTIMIZED: Build all meshes efficiently
      const chunkArray = Array.from(chunks.values());
      for (let chunkIdx = 0; chunkIdx < chunkArray.length; chunkIdx++) {
        const chunk = chunkArray[chunkIdx];
        chunk.lod = { HIGH: [], MID: [], LOW: [] };

        const clusterEntries = Array.from(chunk.clusters.entries()) as [
          number,
          THREE.Vector3[],
        ][];
        for (let entryIdx = 0; entryIdx < clusterEntries.length; entryIdx++) {
          const [ci, points] = clusterEntries[entryIdx];
          const cluster = clusters[ci];

          const mat = new THREE.MeshStandardMaterial({
            color: cluster.color,
            emissive: cluster.color,
            emissiveIntensity: 2.25,
            metalness: 0.0,
            roughness: 0.0,
            polygonOffset: true,
            polygonOffsetFactor: 1,
            polygonOffsetUnits: 1,
          });
          // store phase offset for pulse animation
          (mat as any)._phase = Math.random() * Math.PI * 2;
          allMaterials.push(mat);

          // Glow sprites for this cluster's points
          const glowMat = new THREE.SpriteMaterial({
            map: glowTexture,
            color: cluster.color,
            transparent: true,
            opacity: 0.55,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
          });
          if (!chunk.sprites) chunk.sprites = [];
          for (let i = 0; i < points.length; i++) {
            const sprite = new THREE.Sprite(glowMat.clone());
            sprite.position.copy(points[i]);
            sprite.scale.setScalar(60);
            sprite.visible = false;
            scene.add(sprite);
            chunk.sprites.push(sprite);
            allSprites.push(sprite);
          }

          const levels = ["HIGH", "MID", "LOW"] as const;
          for (let levelIdx = 0; levelIdx < levels.length; levelIdx++) {
            const level = levels[levelIdx];
            const mesh = new THREE.InstancedMesh(
              GEO[level],
              mat,
              points.length,
            );
            mesh.visible = false;
            mesh.frustumCulled = true; // Enable Three.js frustum culling for the mesh
            mesh.userData = { points, concept: cluster.concept };

            // OPTIMIZED: Batch matrix updates
            for (let i = 0; i < points.length; i++) {
              dummy.position.copy(points[i]);
              dummy.updateMatrix();
              mesh.setMatrixAt(i, dummy.matrix);
            }
            mesh.instanceMatrix.needsUpdate = true;

            scene.add(mesh);
            chunk.lod[level].push(mesh);
            allMeshes.push(mesh);
          }
        }
      }

      // ===== RAYCAST =====
      const raycaster = new THREE.Raycaster();
      const centerMouse = new THREE.Vector2(0, 0);
      let selectedSphere: any = null;

      // highlight
      const ring = new THREE.Mesh(
        new THREE.RingGeometry(12, 15, 32),
        new THREE.MeshBasicMaterial({
          color: 0xffffff,
          side: THREE.DoubleSide,
        }),
      );
      ring.visible = false;
      scene.add(ring);

      // ===== CAMERA ANIM =====
      let isAnimating = false;
      let animationStart = 0;
      const animationDuration = CONFIG.camera.animationDuration;
      const startQuat = new THREE.Quaternion(), targetQuat = new THREE.Quaternion();
      let travelCurve: THREE.CatmullRomCurve3 | null = null;
      const _curvePt = new THREE.Vector3();
      const _curveLook = new THREE.Vector3();

      function moveCameraToCluster(cluster: any) {
        const target = cluster.navPoint.clone();
        const dist = 120;
        const dir = new THREE.Vector3().subVectors(camera.position, target).normalize();
        if (dir.lengthSq() === 0) dir.set(0, 0, 1);
        const endPos = target.clone().addScaledVector(dir, dist);
        const lookM = new THREE.Matrix4().lookAt(endPos, target, new THREE.Vector3(0, 1, 0));

        travelCurve = new THREE.CatmullRomCurve3([camera.position.clone(), endPos]);
        startQuat.copy(camera.quaternion);
        targetQuat.setFromRotationMatrix(lookM);
        animationStart = performance.now();
        isAnimating = true;
      }

      function gotoIndex(i: number) {
        if (isAnimating || !navigableClusters.length) return;
        currentNavIndex = (i + navigableClusters.length) % navigableClusters.length;
        moveCameraToCluster(navigableClusters[currentNavIndex]);
      }
      const gotoNext = () => gotoIndex(currentNavIndex + 1);
      const gotoPrev = () => gotoIndex(currentNavIndex - 1);

      // LEFT / RIGHT CLICK = navigation
      addEventListener("mousedown", (e: MouseEvent) => {
        const el = e.target as HTMLElement;
        if (el?.closest("#help") || el?.closest("#modal")) return;
        if (!selectedSphere?.concept) return;

        currentNavIndex = navigableClusters.findIndex(
          (c: any) => c.concept.id === selectedSphere.concept.id,
        );
        if (currentNavIndex === -1) return;

        if (e.button === 0) gotoNext();
        if (e.button === 2) gotoPrev();
      });

      // pointer lock
      document.body.onclick = (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        if (target?.closest("#help") || target?.closest("#modal")) return;
        document.body.requestPointerLock();
      };

      // ===== KEYBOARD MOVEMENT =====
      const keys = Object.create(null);

      const keystrokeDisplay = document.getElementById("keystroke-display")!;
      const keyLabels: Record<string, string> = {
        KeyW: "W", KeyA: "A", KeyS: "S", KeyD: "D",
        ArrowUp: "↑", ArrowLeft: "←", ArrowDown: "↓", ArrowRight: "→",
        ShiftLeft: "⇧ Shift", ShiftRight: "⇧ Shift",
        Space: "Space", KeyP: "P", Escape: "Esc",
      };

      const activeToasts = new Map<string, HTMLElement>();

      function showKeystroke(label: string, id: string) {
        if (activeToasts.has(id)) return;
        const toast = document.createElement("div");
        toast.className = "kbc-toast kbc-held";
        toast.innerHTML = `<kbd class="kbc-button">${label}</kbd>`;
        keystrokeDisplay.appendChild(toast);
        activeToasts.set(id, toast);
      }

      function hideKeystroke(id: string) {
        const toast = activeToasts.get(id);
        if (!toast) return;
        activeToasts.delete(id);
        toast.classList.remove("kbc-held");
        setTimeout(() => toast.remove(), 200);
      }

      addEventListener("keydown", (e: KeyboardEvent) => {
        keys[e.code] = true;
        const label = keyLabels[e.code];
        if (label) showKeystroke(label, e.code);
      });

      addEventListener("keyup", (e: KeyboardEvent) => {
        keys[e.code] = false;
        hideKeystroke(e.code);
      });

      addEventListener("mousedown", (e: MouseEvent) => {
        const el = e.target as HTMLElement;
        if (el?.closest("#help") || el?.closest("#modal")) return;
        if (e.button === 0) showKeystroke("🖱 Left", "mouse0");
        if (e.button === 2) showKeystroke("🖱 Right", "mouse2");
      });

      addEventListener("mouseup", (e: MouseEvent) => {
        if (e.button === 0) hideKeystroke("mouse0");
        if (e.button === 2) hideKeystroke("mouse2");
      });

      const MOVE = {
        forward: new THREE.Vector3(),
        right: new THREE.Vector3(),
        dir: new THREE.Vector3(),
      };

      const WALK_SPEED = CONFIG.camera.walkSpeed;
      const SPRINT_SPEED = WALK_SPEED * CONFIG.camera.sprintMultiplier;

      // ===== KEYBOARD VELOCITY =====
      const velocity = new THREE.Vector3();
      const FRICTION = 0.72; // bleed off speed — lower = more slide

      function moveCamera(dt: number) {
        MOVE.dir.set(0, 0, 0);

        MOVE.forward.set(0, 0, -1).applyQuaternion(camera.quaternion);
        MOVE.right.set(1, 0, 0).applyQuaternion(camera.quaternion);

        if (keys.KeyW || keys.ArrowUp) MOVE.dir.add(MOVE.forward);
        if (keys.KeyS || keys.ArrowDown) MOVE.dir.sub(MOVE.forward);
        if (keys.KeyD || keys.ArrowRight) MOVE.dir.add(MOVE.right);
        if (keys.KeyA || keys.ArrowLeft) MOVE.dir.sub(MOVE.right);

        const speed = keys.ShiftLeft ? SPRINT_SPEED : WALK_SPEED;

        if (MOVE.dir.lengthSq() > 0) {
          MOVE.dir.normalize();
          // accelerate toward target speed
          velocity.addScaledVector(MOVE.dir, speed * dt * 0.001);
        }

        // apply friction every frame so it bleeds off when keys released
        velocity.multiplyScalar(FRICTION);

        if (velocity.lengthSq() > 0.0001) {
          camera.position.add(velocity);
        } else {
          velocity.set(0, 0, 0);
        }
      }

      // ===== INPUT =====
      let rx = 0, ry = 0;
      let targetRx = 0, targetRy = 0;
      const LOOK_SMOOTH = 0.12; // lower = smoother/lazier, higher = snappier

      addEventListener("mousemove", (e: MouseEvent) => {
        if (document.pointerLockElement !== document.body || isAnimating) return;
        targetRy -= e.movementX * 0.002;
        targetRx -= e.movementY * 0.002;
        targetRx = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, targetRx));
      });

      // ===== LOOP =====
      let last = performance.now(),
        fps = 0,
        fc = 0,
        ft = performance.now();
      let raycastFrame = 0;

      // Pre-calculate squared distances to avoid sqrt
      const RENDER_DIST_SQ = RENDER_DIST * RENDER_DIST;
      const LOD_HIGH_SQ = CONFIG.lod.high.distance * CONFIG.lod.high.distance;
      const LOD_MID_SQ = CONFIG.lod.mid.distance * CONFIG.lod.mid.distance;

      // Reusable vector for distance calculations
      const tempVec = new THREE.Vector3();

      function pickLODSquared(dSq: number) {
        return dSq < LOD_HIGH_SQ ? "HIGH" : dSq < LOD_MID_SQ ? "MID" : "LOW";
      }

      // Reusable frustum for culling checks
      const frustum = new THREE.Frustum();
      const frustumMatrix = new THREE.Matrix4();
      const instancePos = new THREE.Vector3();
      const instanceMatrix = new THREE.Matrix4();

      function updatePerfStats() {
        perfStats.drawCalls = renderer.info.render.calls;
        perfStats.triangles = renderer.info.render.triangles;

        // Build frustum from current camera
        frustumMatrix.multiplyMatrices(camera.projectionMatrix, camera.matrixWorldInverse);
        frustum.setFromProjectionMatrix(frustumMatrix);

        // Count only instances whose position is inside the frustum
        let count = 0;
        for (let i = 0; i < allMeshes.length; i++) {
          const mesh = allMeshes[i];
          if (!mesh.visible) continue;
          for (let j = 0; j < mesh.count; j++) {
            mesh.getMatrixAt(j, instanceMatrix);
            instancePos.setFromMatrixPosition(instanceMatrix);
            if (frustum.containsPoint(instancePos)) count++;
          }
        }
        perfStats.visibleSpheres = count;

        perfStats.activeChunks = Array.from(chunks.values()).filter(
          (c) => c.current !== null,
        ).length;

        // Memory (if available) - use any to avoid TS error
        const perf = performance as any;
        if (perf.memory) {
          perfStats.memoryUsage = Math.round(
            perf.memory.usedJSHeapSize / 1048576,
          );
        }

        // Update HUD
        hud.innerHTML = `
        FPS: ${fps}<br>
        Draw: ${perfStats.drawCalls}<br>
        Tris: ${(perfStats.triangles / 1000).toFixed(1)}k<br>
        In View: ${perfStats.visibleSpheres}<br>
        Chunks: ${perfStats.activeChunks}<br>
        Mem: ${perfStats.memoryUsage}MB
      `;
      }

      // Reset timing state when tab becomes visible again to avoid stale dt/fps
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) {
          last = performance.now();
          ft = performance.now();
          fc = 0;
          fps = 60; // assume good fps until measured
        }
      });

      function loop(now = performance.now()) {
        requestAnimationFrame(loop);
        const dt = Math.min(now - last, 100); // clamp dt — prevents huge jump on tab return
        last = now;

        fc++;
        if (now - ft >= 500) {
          fps = Math.round((fc * 1000) / (now - ft));
          fc = 0;
          ft = now;
        }
        perfStats.frameCount++;

        if (isAnimating) {
          const t = Math.min((now - animationStart) / animationDuration, 1);
          const s = t * t * (3 - 2 * t);

          if (travelCurve) {
            travelCurve.getPoint(s, _curvePt);
            camera.position.copy(_curvePt);
            // look slightly ahead on the travel curve
            travelCurve.getPoint(Math.min(1, s + 0.05), _curveLook);
            camera.quaternion.slerpQuaternions(startQuat, targetQuat, s);
          }

          if (t >= 1) {
            isAnimating = false;
            travelCurve = null;
            const eul = new THREE.Euler().setFromQuaternion(camera.quaternion, "YXZ");
            rx = eul.x; ry = eul.y;
            targetRx = rx; targetRy = ry;
          }
        }

        if (!isAnimating && document.pointerLockElement === document.body) {
          // Smooth look — lerp current rotation toward target
          rx += (targetRx - rx) * LOOK_SMOOTH;
          ry += (targetRy - ry) * LOOK_SMOOTH;
          camera.rotation.set(rx, ry, 0, "YXZ");
          moveCamera(dt);
        }

        // Clear visible meshes cache
        visibleMeshes.length = 0;

        // OPTIMIZED: Use squared distance to avoid sqrt
        for (const chunk of chunks.values()) {
          tempVec.copy(camera.position).sub(chunk.center);
          const dSq = tempVec.lengthSq();

          // Skip distant chunks more frequently
          if (CONFIG.performance.distanceBasedUpdates) {
            const d = Math.sqrt(dSq); // Only sqrt when needed
            const updateFrequency = d < 3000 ? 1 : d < 6000 ? 2 : 4;
            if (perfStats.frameCount % updateFrequency !== 0) continue;
          }

          if (dSq > RENDER_DIST_SQ) {
            if (chunk.current) {
              for (let i = 0; i < chunk.lod[chunk.current].length; i++) {
                chunk.lod[chunk.current][i].visible = false;
              }
              if (chunk.sprites) {
                for (let i = 0; i < chunk.sprites.length; i++) chunk.sprites[i].visible = false;
              }
            }
            chunk.current = null;
            continue;
          }

          const l = pickLODSquared(dSq);
          if (chunk.current !== l) {
            if (chunk.current) {
              for (let i = 0; i < chunk.lod[chunk.current].length; i++) {
                chunk.lod[chunk.current][i].visible = false;
              }
            }
            const newLOD = chunk.lod[l];
            for (let i = 0; i < newLOD.length; i++) {
              newLOD[i].visible = true;
              visibleMeshes.push(newLOD[i]); // Cache visible meshes
            }
            if (chunk.sprites) {
              for (let i = 0; i < chunk.sprites.length; i++) chunk.sprites[i].visible = true;
            }
            chunk.current = l;
          } else if (chunk.current) {
            // Add already visible meshes to cache
            const currentLOD = chunk.lod[chunk.current];
            for (let i = 0; i < currentLOD.length; i++) {
              visibleMeshes.push(currentLOD[i]);
            }
          }
        }

        // OPTIMIZED: Use cached visible meshes for raycasting
        if (!isAnimating) {
          raycastFrame++;
          if (raycastFrame % CONFIG.performance.raycastInterval === 0) {
            raycaster.setFromCamera(centerMouse, camera);
            const hits = raycaster.intersectObjects(visibleMeshes);
            if (hits.length) {
              const h = hits[0];
              const p = h.object.userData.points[h.instanceId!];
              selectedSphere = {
                position: p,
                concept: h.object.userData.concept,
              };
              ring.position.copy(p);
              ring.lookAt(camera.position);
              ring.visible = true;
              info.style.display = "block";
              info.innerHTML = `<b>${selectedSphere.concept.name}</b><br><span style="font-size:12px;opacity:.7">${selectedSphere.concept.description}</span>`;

              // Show only lines connected to hovered sphere, hide the rest
              const hovIdx = navigableClusters.findIndex(
                (c: any) => c.concept.id === selectedSphere.concept.id,
              );
              for (let li = 0; li < connLines.length; li++) {
                const cl = connLines[li];
                // next: this sphere is the "from" end → going forward
                // prev: this sphere is the "to" end → going backward
                if (cl.fromIdx === hovIdx) {
                  cl.mat.color.set(0x00ff88); // green = next
                  cl.mesh.visible = true;
                } else if (cl.toIdx === hovIdx) {
                  cl.mat.color.set(0xff8800); // orange = previous
                  cl.mesh.visible = true;
                } else {
                  cl.mesh.visible = false;
                }
              }
            } else {
              selectedSphere = null;
              ring.visible = false;
              info.style.display = "none";
              // Hide all lines
              for (let li = 0; li < connLines.length; li++) {
                connLines[li].mesh.visible = false;
              }
            }
          }
        }

        // ===== PULSE ANIMATION =====
        const t_sec = now * 0.002;
        for (let i = 0; i < allMaterials.length; i++) {
          const m = allMaterials[i] as any;
          const pulse = Math.sin(t_sec * 1.2 + m._phase) * 0.5 + 0.5; // 0..1
          m.emissiveIntensity = 1.44 + pulse * 1.12; // ~20% less than before
        }
        for (let i = 0; i < allSprites.length; i++) {
          const s = allSprites[i];
          if (!s.visible) continue;
          const m = s.material as any;
          const pulse = Math.sin(t_sec * 1.2 + (m._phase ?? 0)) * 0.5 + 0.5;
          m.opacity = 0.28 + pulse * 0.28; // 0.28 .. 0.56
          const scale = 49 + pulse * 12; // 44 .. 56
          s.scale.setScalar(scale);
        }

        // OPTIMIZATION: Conditional bloom rendering
        if (
          CONFIG.performance.enableBloom &&
          fps > CONFIG.performance.bloomFPSThreshold
        ) {
          composer.render();
        } else {
          renderer.render(scene, camera);
        }

        drawMinimap();
        updatePerfStats();
      }
      loop();

      addEventListener("resize", () => {
        camera.aspect = innerWidth / innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(innerWidth, innerHeight);
        composer.setSize(innerWidth, innerHeight);
      });

      // ===== PERFORMANCE MONITORING OVERLAY =====
      const perfOverlay = document.createElement("div");
      perfOverlay.style.cssText = `
      position: fixed;
      top: 50px;
      left: 10px;
      background: rgba(0,0,0,0.8);
      color: #0f0;
      padding: 10px;
      font-family: monospace;
      font-size: 11px;
      z-index: 1000;
      display: none;
      border: 1px solid #0f0;
      border-radius: 4px;
    `;
      document.body.appendChild(perfOverlay);

      // Toggle performance overlay with 'P' key
      addEventListener("keydown", (e) => {
        if (e.code === "KeyP") {
          perfOverlay.style.display =
            perfOverlay.style.display === "none" ? "block" : "none";
        }
      });

      // Log performance every 10 seconds
      setInterval(() => {
        const perf = performance as any;
        console.log("Performance Metrics:", {
          fps,
          drawCalls: renderer.info.render.calls,
          triangles: renderer.info.render.triangles,
          memory: perf.memory ? perf.memory.usedJSHeapSize / 1048576 : 0,
          visibleSpheres: perfStats.visibleSpheres,
          activeChunks: perfStats.activeChunks,
        });
      }, 10000);
    </script>
  </body>
</html>
