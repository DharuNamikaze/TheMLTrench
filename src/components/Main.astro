<script is:inline type="module">
  // ===============================
  // IMPORT THREE.JS LIBRARY
  // ===============================
  // Import Three.js from CDN - a powerful 3D graphics library for WebGL
  import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.module.js";

  // ===============================
  // GLOBAL CANVAS STYLING
  // ===============================
  // Create and inject CSS to make the canvas fullscreen without distortion
  const style = document.createElement("style");
  style.textContent = `
    body {
      margin: 0;           /* Remove default body margin */
      padding: 0;          /* Remove default body padding */
      overflow: hidden;    /* Hide scrollbars for immersive experience */
    }
canvas#webgl-renderer {
  display: block;
  width: 100vw !important;
  height: 100vh !important;
  position: fixed;
  top: 0;
  left: 0;
}
  `;
  document.head.appendChild(style); // Inject styles into document head

  // ===============================
  // 0️⃣ CROSSHAIR SETUP
  // ===============================
  // Create a centered crosshair for aiming/targeting spheres
  const crosshair = document.createElement("div");
  crosshair.id = "crosshair";
  crosshair.style.cssText = `
    position: fixed;                              /* Fix to viewport */
    top: 50%;                                     /* Center vertically */
    left: 50%;                                    /* Center horizontally */
    transform: translate(-50%, -50%);             /* Offset by half size for true center */
    width: 30px;                                  /* Crosshair outer circle width */
    height: 30px;                                 /* Crosshair outer circle height */
    border: 2px solid rgba(135, 206, 235, 0.8);  /* Sky blue border */
    border-radius: 50%;                           /* Make it circular */
    pointer-events: none;                         /* Don't block mouse events */
    z-index: 1000;                                /* Render above 3D scene */
    transition: border-color 0.2s;                /* Smooth color transition on hover */
  `;

  // Create the center dot of the crosshair
  const crosshairDot = document.createElement("div");
  crosshairDot.style.cssText = `
    position: absolute;                           /* Position relative to parent */
    top: 50%;                                     /* Center vertically in parent */
    left: 50%;                                    /* Center horizontally in parent */
    transform: translate(-50%, -50%);             /* Offset for true center */
    width: 4px;                                   /* Small dot size */
    height: 4px;                                  /* Small dot size */
    background: rgba(135, 206, 235, 0.8);        /* Sky blue fill */
    border-radius: 50%;                           /* Make it circular */
  `;
  crosshair.appendChild(crosshairDot); // Add dot to crosshair
  document.body.appendChild(crosshair); // Add crosshair to page

  // ===============================
  // 1️⃣ SCENE SETUP
  // ===============================
  // Create the 3D scene - this is the container for all 3D objects
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x000000); // Set background to black (space)

  // Create the camera - this is the viewer's perspective into the 3D world
  const camera = new THREE.PerspectiveCamera(
    60, // Field of view in degrees (reduced from 75 to 60 to reduce fisheye distortion)
    window.innerWidth / window.innerHeight, // Aspect ratio (width/height)
    0.1, // Near clipping plane (objects closer than this won't render)
    12500, // Far clipping plane (increased to match render distance + buffer)
  );
  camera.position.set(0, 0, 100); // Start camera at origin, 100 units forward

  // Create the renderer - this draws the 3D scene to the screen
  const renderer = new THREE.WebGLRenderer({
    antialias: true, // Smooth edges for better visual quality
    alpha: false, // No transparency (opaque background)
    powerPreference: "high-performance", // Use GPU for better performance
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(window.devicePixelRatio);
  renderer.domElement.id = "webgl-renderer"; // Add this line
  document.body.appendChild(renderer.domElement);
  // ===============================
  // 2️⃣ CLUSTER COLORS (50 clusters × 100 spheres = 5000 total)
  // ===============================
  // Define 50 distinct colors for the 50 clusters
  // Each cluster will have 100 spheres of the same color
  const clusterColors = [
    0x4fc3f7, // Cyan - Cluster 1
    0xff6b9d, // Pink - Cluster 2
    0x00ff88, // Green - Cluster 3
    0xffd700, // Gold - Cluster 4
    0xff4500, // Orange Red - Cluster 5
    0x9370db, // Purple - Cluster 6
    0x00ced1, // Dark Turquoise - Cluster 7
    0xff1493, // Deep Pink - Cluster 8
    0x7fff00, // Chartreuse - Cluster 9
    0xff00ff, // Magenta - Cluster 10
    0x1e90ff, // Dodger Blue - Cluster 11
    0xff69b4, // Hot Pink - Cluster 12
    0x32cd32, // Lime Green - Cluster 13
    0xffa500, // Orange - Cluster 14
    0x8a2be2, // Blue Violet - Cluster 15
    0x00ffff, // Aqua - Cluster 16
    0xff8c00, // Dark Orange - Cluster 17
    0xadff2f, // Green Yellow - Cluster 18
    0xff00bf, // Rose - Cluster 19
    0x00bfff, // Deep Sky Blue - Cluster 20
    0xffff00, // Yellow - Cluster 21
    0xff1493, // Deep Pink 2 - Cluster 22
    0x00fa9a, // Medium Spring Green - Cluster 23
    0xff6347, // Tomato - Cluster 24
    0x9400d3, // Dark Violet - Cluster 25
    0x40e0d0, // Turquoise - Cluster 26
    0xff7f50, // Coral - Cluster 27
    0x7cfc00, // Lawn Green - Cluster 28
    0xda70d6, // Orchid - Cluster 29
    0x87ceeb, // Sky Blue - Cluster 30
    0xffd700, // Gold 2 - Cluster 31
    0xff4500, // Orange Red 2 - Cluster 32
    0x00ff7f, // Spring Green - Cluster 33
    0xff69b4, // Hot Pink 2 - Cluster 34
    0x4169e1, // Royal Blue - Cluster 35
    0xffa07a, // Light Salmon - Cluster 36
    0x98fb98, // Pale Green - Cluster 37
    0xdda0dd, // Plum - Cluster 38
    0xf0e68c, // Khaki - Cluster 39
    0xe0ffff, // Light Cyan - Cluster 40
    0xffdab9, // Peach Puff - Cluster 41
    0xb0e0e6, // Powder Blue - Cluster 42
    0xffb6c1, // Light Pink - Cluster 43
    0x90ee90, // Light Green - Cluster 44
    0xffc0cb, // Pink - Cluster 45
    0xadd8e6, // Light Blue - Cluster 46
    0xf08080, // Light Coral - Cluster 47
    0xe6e6fa, // Lavender - Cluster 48
    0xfffacd, // Lemon Chiffon - Cluster 49
    0xffe4e1, // Misty Rose - Cluster 50
  ];

  // ===============================
  // 3️⃣ CREATE GLOWING SPHERES WITH DISTANCE-BASED LAZY LOADING
  // ===============================
  // PERFORMANCE OPTIMIZATION: Only render spheres within a certain distance from camera
  // This dramatically improves FPS by not rendering distant objects

  const sphereData = []; // Array to store metadata for all 1000 spheres
  const loadedSpheres = new Map(); // Map to track which spheres are currently loaded in the scene
  const geometry = new THREE.SphereGeometry(8, 16, 16); // Shared geometry for all spheres (radius=8, segments=16x16)
  const RENDER_DISTANCE = 12500; // Load spheres within 20500 units of camera
  const UNLOAD_DISTANCE = 12500; // Unload spheres beyond 24000 units (large buffer to keep entire clusters visible)

  // ===============================
  // PERFORMANCE TRACKING SYSTEM
  // ===============================
  // Track and display real-time performance metrics
  const performanceStats = {
    totalDots: 5000, // Total number of dots in the scene (50 clusters × 100 dots)
    loadedDots: 0, // Currently loaded/rendered dots
    fps: 0, // Frames per second
    frameTime: 0, // Time to render one frame (ms)
    lastFrameTime: performance.now(), // Timestamp of last frame
  };

  // ===============================
  // PERFORMANCE DISPLAY UI
  // ===============================
  // Create a HUD element to show real-time performance metrics
  const perfDisplay = document.createElement("div");
  // Update the performance display CSS to be smaller and not overlap
  perfDisplay.style.cssText = `
  position: fixed;
  top: 10px;
  left: 10px;
  background: rgba(0, 0, 0, 0.7);
  color: #fc6203;
  padding: 10px;
  font-family: 'Courier New', monospace;
  font-size: 11px;
  border-radius: 5px;
  z-index: 998;
  line-height: 1.4;
  border: 1px solid rgba(0, 255, 36, 0.3);
  max-width: 220px;
  backdrop-filter: blur(2px);
`;
  document.body.appendChild(perfDisplay); // Add to page

  // ===============================
  // UPDATE PERFORMANCE DISPLAY
  // ===============================
  // Function to calculate and update performance metrics every frame
  function updatePerformanceDisplay() {
    // Calculate FPS (frames per second)
    const now = performance.now(); // Current timestamp
    const delta = now - performanceStats.lastFrameTime; // Time since last frame
    performanceStats.lastFrameTime = now; // Update last frame time
    performanceStats.fps = Math.round(1000 / delta); // FPS = 1000ms / frame time
    performanceStats.frameTime = delta.toFixed(2); // Frame time in ms

    // Get memory usage (if available in browser)
    const memoryUsage = performance.memory
      ? `${(performance.memory.usedJSHeapSize / 1048576).toFixed(2)} MB` // Convert bytes to MB
      : "N/A"; // Not available in all browsers

    // Calculate loading statistics
    const loadPercentage = (
      (performanceStats.loadedDots / performanceStats.totalDots) *
      100
    ).toFixed(1); // % of dots loaded
    const memorySaved = (
      (1 - performanceStats.loadedDots / performanceStats.totalDots) *
      100
    ).toFixed(0); // % memory saved

    // Update the display with formatted HTML
    perfDisplay.innerHTML = `
      <strong>🚀 PERFORMANCE METRICS</strong><br>
      ━━━━━━━━━━━━━━━━━━━━━━<br>
      FPS: <span style="color: ${performanceStats.fps > 50 ? "#00ff88" : "#ff4500"}">${performanceStats.fps}</span><br>
      Frame Time: ${performanceStats.frameTime}ms<br>
      ━━━━━━━━━━━━━━━━━━━━━━<br>
      <strong>📦 DISTANCE-BASED LOADING</strong><br>
      Loaded Dots: ${performanceStats.loadedDots}/${performanceStats.totalDots} (${loadPercentage}%)<br>
      Memory Saved: ~${memorySaved}%<br>
      Render Distance: ${RENDER_DISTANCE} units<br>
      ━━━━━━━━━━━━━━━━━━━━━━<br>
      Memory Usage: ${memoryUsage}<br>
      Camera: (${camera.position.x.toFixed(0)}, ${camera.position.y.toFixed(0)}, ${camera.position.z.toFixed(0)})
    `;
  }

  // ===============================
  // MINIMAP SETUP - TOP-RIGHT OVERVIEW MAP
  // ===============================
  // Create a 2D canvas minimap showing bird's-eye view of entire 3D space
  // This helps users navigate and see where all clusters are located

  const minimapCanvas = document.createElement("canvas"); // Create canvas element
  minimapCanvas.width = 150; // Internal resolution width
  minimapCanvas.height = 150; // Internal resolution height
  minimapCanvas.style.cssText = `
    position: fixed;                              /* Fix to viewport */
bottom: 20px;    // was: top: 20px
left: 20px;      // was: right: 20px
width: 150px;    // was: 1px
height: 150px;   // was: 1px                              /* Display height */
    background: rgba(0, 0, 0, 0.9);              /* Almost black background */
    border: 2px solid rgba(0, 255, 136, 0.7);    /* Green border */
    border-radius: 10px;                          /* Rounded corners */
    z-index: 999;                                 /* Render below crosshair */
    pointer-events: none;                         /* Non-interactive (no clicks) */
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.5); /* Glowing effect */
  `;
  document.body.appendChild(minimapCanvas); // Add to page

  const minimapCtx = minimapCanvas.getContext("2d"); // Get 2D drawing context

  // ===============================
  // MINIMAP BOUNDS CALCULATION
  // ===============================
  // Track the min/max coordinates of all spheres to scale the minimap properly
  let minX = Infinity,
    maxX = -Infinity; // X-axis bounds
  let minY = Infinity,
    maxY = -Infinity; // Y-axis bounds
  let minZ = Infinity,
    maxZ = -Infinity; // Z-axis bounds

  // Function to calculate the bounding box of all spheres
  // Called after sphere data is generated
  function updateMinimapBounds() {
    // Loop through all sphere data and find min/max coordinates
    sphereData.forEach((data) => {
      minX = Math.min(minX, data.position.x); // Find leftmost point
      maxX = Math.max(maxX, data.position.x); // Find rightmost point
      minY = Math.min(minY, data.position.y); // Find lowest point
      maxY = Math.max(maxY, data.position.y); // Find highest point
      minZ = Math.min(minZ, data.position.z); // Find nearest point
      maxZ = Math.max(maxZ, data.position.z); // Find farthest point
    });
  }

  // Calculate world dimensions for scaling
  const worldWidth = () => maxX - minX; // Total width of the space
  const worldHeight = () => maxZ - minZ; // Total height of the space
  // Calculate scale factor to fit entire world in 150px canvas (with 25px padding)
  const scale = () => Math.min(125 / worldWidth(), 125 / worldHeight());

  // ===============================
  // UPDATE MINIMAP FUNCTION
  // ===============================
  // Draws the minimap every frame showing:
  // - All dots (colored by cluster, opacity by load status)
  // - Camera position and direction
  // - Render distance circle
  // - Grid and labels
  function updateMinimap() {
    // Clear the canvas for fresh draw
    minimapCtx.fillStyle = "rgba(0, 0, 0, 0.95)"; // Almost black
    minimapCtx.fillRect(0, 0, 150, 150); // Fill entire canvas

    // Draw background grid for spatial reference
    minimapCtx.strokeStyle = "rgba(255, 255, 255, 0.15)"; // Faint white lines
    minimapCtx.lineWidth = 1;
    for (let i = 0; i <= 150; i += 30) {
      // Every 30 pixels
      // Vertical lines
      minimapCtx.beginPath();
      minimapCtx.moveTo(i, 0);
      minimapCtx.lineTo(i, 150);
      minimapCtx.stroke();
      // Horizontal lines
      minimapCtx.beginPath();
      minimapCtx.moveTo(0, i);
      minimapCtx.lineTo(150, i);
      minimapCtx.stroke();
    }

    // Draw border frame
    minimapCtx.strokeStyle = "rgba(0, 255, 136, 0.3)"; // Subtle green
    minimapCtx.lineWidth = 2;
    minimapCtx.strokeRect(8, 20, 134, 122); // Inner frame

    // Draw all dots (spheres) on the minimap
    sphereData.forEach((data) => {
      // Convert 3D world coordinates to 2D minimap coordinates
      // Center the world, scale it, then offset to canvas center (75, 75)
      const x = (data.position.x - (minX + maxX) / 2) * scale() + 75;
      const y = (data.position.z - (minZ + maxZ) / 2) * scale() + 75;

      // Check if this dot is currently loaded in the 3D scene
      const isLoaded = loadedSpheres.has(data.index);
      // Use the dot's cluster color
      minimapCtx.fillStyle = `#${data.color.toString(16).padStart(6, "0")}`;
      // Loaded dots are bright (0.9), unloaded are dim (0.3)
      minimapCtx.globalAlpha = isLoaded ? 0.9 : 0.3;
      minimapCtx.beginPath();
      // Loaded dots are slightly larger (2px) than unloaded (1px)
      minimapCtx.arc(x, y, isLoaded ? 2 : 1, 0, Math.PI * 2);
      minimapCtx.fill();
    });

    minimapCtx.globalAlpha = 1; // Reset opacity

    // Draw render distance circle (shows which dots are being rendered)
    const renderRadiusOnMap = RENDER_DISTANCE * scale(); // Scale render distance to map
    // Convert camera position to minimap coordinates
    const camX = (camera.position.x - (minX + maxX) / 2) * scale() + 75;
    const camY = (camera.position.z - (minZ + maxZ) / 2) * scale() + 75;

    minimapCtx.strokeStyle = "rgba(135, 206, 235, 0.6)"; // Sky blue
    minimapCtx.lineWidth = 1.5;
    minimapCtx.setLineDash([4, 4]); // Dashed line
    minimapCtx.beginPath();
    minimapCtx.arc(camX, camY, renderRadiusOnMap, 0, Math.PI * 2);
    minimapCtx.stroke();
    minimapCtx.setLineDash([]); // Reset to solid line

    // Draw camera position with glow effect
    minimapCtx.shadowBlur = 6; // Glow radius
    minimapCtx.shadowColor = "#00ff88"; // Green glow
    minimapCtx.fillStyle = "#00ff88"; // Green dot
    minimapCtx.beginPath();
    minimapCtx.arc(camX, camY, 3, 0, Math.PI * 2); // 3px radius dot
    minimapCtx.fill();
    minimapCtx.shadowBlur = 0; // Turn off glow for next draws

    // Draw camera direction indicator (shows which way camera is facing)
    const dirLength = 12; // Length of direction line
    // Calculate direction based on camera rotation
    const dirX = Math.sin(camera.rotation.y) * dirLength;
    const dirY = Math.cos(camera.rotation.y) * dirLength;

    minimapCtx.strokeStyle = "#00ff88"; // Green line
    minimapCtx.lineWidth = 2;
    minimapCtx.beginPath();
    minimapCtx.moveTo(camX, camY); // Start at camera position
    minimapCtx.lineTo(camX + dirX, camY - dirY); // Draw to direction point
    minimapCtx.stroke();

    // Draw title bar at top
    minimapCtx.fillStyle = "rgba(0, 0, 0, 0.8)"; // Dark background
    minimapCtx.fillRect(0, 0, 150, 18); // Title bar rectangle
    minimapCtx.fillStyle = "#00ff88"; // Green text
    minimapCtx.font = "bold 10px Courier New";
    minimapCtx.fillText("🗺️ MAP", 8, 12); // Title

    // Draw dot count in top right
    minimapCtx.fillStyle = "rgba(255, 255, 255, 0.7)"; // Light gray
    minimapCtx.font = "7px Courier New";
    minimapCtx.fillText(`${sphereData.length}`, 115, 12); // Show total dots
  }

  // Create glow texture for sprites (enhanced neon glow)
  const canvas = document.createElement("canvas");
  canvas.width = 256;
  canvas.height = 256;
  const ctx = canvas.getContext("2d");

  // Create intense neon glow with multiple layers
  const gradient = ctx.createRadialGradient(128, 128, 0, 128, 128, 128);
  gradient.addColorStop(0, "rgba(255, 255, 255, 1)");
  gradient.addColorStop(0.1, "rgba(255, 255, 255, 0.9)");
  gradient.addColorStop(0.2, "rgba(255, 255, 255, 0.7)");
  gradient.addColorStop(0.3, "rgba(255, 255, 255, 0.5)");
  gradient.addColorStop(0.5, "rgba(255, 255, 255, 0.3)");
  gradient.addColorStop(0.7, "rgba(255, 255, 255, 0.15)");
  gradient.addColorStop(1, "rgba(255, 255, 255, 0)");
  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, 256, 256);
  const glowTexture = new THREE.CanvasTexture(canvas);

  // Generate all sphere metadata (5000 dots in 50 clusters)
  // INCREASED DISTANCE: Expanded from 7000 to 15000 for more space between clusters
  let dotIndex = 0;
  for (let clusterIndex = 0; clusterIndex < 50; clusterIndex++) {
    const clusterColor = clusterColors[clusterIndex];

    // Random cluster center in free space - MUCH LARGER SPREAD
    // First cluster spawns near origin (0, 0, 0) to ensure player sees something at start
    const clusterCenter = clusterIndex === 0 
      ? new THREE.Vector3(
          (Math.random() - 0.5) * 1000,  // Close to origin
          (Math.random() - 0.5) * 1000,
          (Math.random() - 0.5) * 1000,
        )
      : new THREE.Vector3(
          (Math.random() - 0.5) * 15000,  // Far spread for other clusters
          (Math.random() - 0.5) * 15000,
          (Math.random() - 0.5) * 15000,
        );

    // Generate 100 dots per cluster - INCREASED CLUSTER SIZE
    for (let i = 0; i < 100; i++) {
      const radius = Math.random() * 1200 + 200; // Increased from 800+100 to 1200+200
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);

      const position = new THREE.Vector3(
        clusterCenter.x + radius * Math.sin(phi) * Math.cos(theta),
        clusterCenter.y + radius * Math.sin(phi) * Math.sin(theta),
        clusterCenter.z + radius * Math.cos(phi),
      );

      sphereData.push({
        index: dotIndex++,
        position: position,
        color: clusterColor,
        cluster: clusterIndex,
        title: `Cluster ${clusterIndex + 1} - Concept ${i + 1}`,
        description: `A concept in cluster ${clusterIndex + 1}`,
      });
    }
  }

  console.log(`✅ Generated ${sphereData.length} dots with metadata`);
  console.log(`📊 Distance-based loading enabled (${RENDER_DISTANCE} units)`);

  // Update minimap bounds after generating all sphere data
  updateMinimapBounds();

  // Function to load a single dot
  function loadDot(data) {
    if (loadedSpheres.has(data.index)) return;

    const material = new THREE.MeshBasicMaterial({
      color: data.color,
      transparent: true,
      opacity: 0.9,
    });

    const sphere = new THREE.Mesh(geometry, material);
    sphere.position.copy(data.position);

    // Add glow sprite
    const spriteMaterial = new THREE.SpriteMaterial({
      map: glowTexture,
      color: data.color,
      transparent: true,
      blending: THREE.AdditiveBlending,
      opacity: 0.5,
    });
    const sprite = new THREE.Sprite(spriteMaterial);
    sprite.scale.set(50, 50, 1);
    sprite.position.copy(data.position);
    scene.add(sprite);

    sphere.userData = {
      title: data.title,
      description: data.description,
      cluster: data.cluster,
      originalColor: data.color,
      glowSprite: sprite,
      dataIndex: data.index,
    };

    scene.add(sphere);

    loadedSpheres.set(data.index, { sphere, sprite });
    performanceStats.loadedDots++;
  }

  // Function to unload a single dot
  function unloadDot(index) {
    const loaded = loadedSpheres.get(index);
    if (!loaded) return;

    scene.remove(loaded.sphere);
    scene.remove(loaded.sprite);
    loadedSpheres.delete(index);
    performanceStats.loadedDots--;
  }

  // Function to update dot loading based on camera distance
  function updateDotLoading() {
    sphereData.forEach((data) => {
      const distance = camera.position.distanceTo(data.position);

      // Load dots within RENDER_DISTANCE
      if (distance < RENDER_DISTANCE && !loadedSpheres.has(data.index)) {
        loadDot(data);
      } 
      // Unload dots beyond UNLOAD_DISTANCE (hysteresis prevents flickering)
      else if (distance >= UNLOAD_DISTANCE && loadedSpheres.has(data.index)) {
        unloadDot(data.index);
      }
    });
  }

  // Initial load of nearby dots
  updateDotLoading();

  // ===============================
  // 4️⃣ MINIMAL LIGHTING
  // ===============================
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.2);
  scene.add(ambientLight);

  // ===============================
  // 5️⃣ FREE-LOOK CAMERA WITH POINTER LOCK (NO SMOOTHING)
  // ===============================
  let rotationX = 0;
  let rotationY = 0;
  let isLocked = false;

  // Click to lock pointer
  document.body.addEventListener("click", () => {
    document.body.requestPointerLock();
  });

  document.addEventListener("pointerlockchange", () => {
    isLocked = document.pointerLockElement === document.body;
  });

  // Mouse move for free look (instant, no smoothing)
  document.addEventListener("mousemove", (e) => {
    if (!isLocked) return;

    // Direct rotation control (no smoothing)
    rotationY -= e.movementX * 0.002;
    rotationX -= e.movementY * 0.002;

    // Clamp vertical rotation to prevent flipping
    rotationX = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, rotationX));

    // Apply rotation using proper Euler order to prevent gimbal lock
    camera.rotation.order = "YXZ";
    camera.rotation.y = rotationY;
    camera.rotation.x = rotationX;
  });

  // ESC to exit pointer lock
  window.addEventListener("keydown", (e) => {
    if (e.code === "Escape") {
      document.exitPointerLock();
    }
  });

  // ===============================
  // 6️⃣ KEYBOARD MOVEMENT
  // ===============================
  const keys = {};
  let speed = 8;
  let isBoosting = false;

  window.addEventListener("keydown", (e) => {
    keys[e.code] = true;
    if (e.code === "ShiftLeft") isBoosting = true;
  });

  window.addEventListener("keyup", (e) => {
    keys[e.code] = false;
    if (e.code === "ShiftLeft") isBoosting = false;
  });

  function movePlayer() {
    const move = new THREE.Vector3();
    const forward = new THREE.Vector3(0, 0, -1);
    const right = new THREE.Vector3(1, 0, 0);

    // Apply camera rotation to movement vectors
    forward.applyQuaternion(camera.quaternion);
    right.applyQuaternion(camera.quaternion);

    if (keys["KeyW"]) move.add(forward);
    if (keys["KeyS"]) move.sub(forward);
    if (keys["KeyD"]) move.add(right);
    if (keys["KeyA"]) move.sub(right);

    move.normalize();

    const currentSpeed = isBoosting ? speed * 6 : speed;
    camera.position.addScaledVector(move, currentSpeed);
  }

  // ===============================
  // 7️⃣ RAYCAST INTERACTION WITH 2D RING
  // ===============================
  const raycaster = new THREE.Raycaster();
  raycaster.far = 500;
  let hovered = null;
  let halo = null;

  const centerMouse = new THREE.Vector2(0, 0);

  // Create 2D ring geometry that always faces camera
  const haloGeometry = new THREE.RingGeometry(15, 20, 32);

  function handleHover() {
    // Get all currently loaded spheres
    const loadedSpheresArray = Array.from(loadedSpheres.values()).map(
      (item) => item.sphere,
    );

    raycaster.setFromCamera(centerMouse, camera);
    const hits = raycaster.intersectObjects(loadedSpheresArray);

    // Reset previous hover
    if (hovered) {
      hovered.material.color.setHex(hovered.userData.originalColor);
      hovered.material.opacity = 0.9;
      hovered.scale.set(1, 1, 1);
      hovered.userData.glowSprite.material.opacity = 0.5;
      hovered = null;

      // Remove halo
      if (halo) {
        scene.remove(halo);
        halo = null;
      }
    }

    // Apply new hover
    if (hits.length > 0) {
      hovered = hits[0].object;

      // Brighten sphere
      hovered.material.color.set(0xffffff);
      hovered.material.opacity = 1.0;
      hovered.scale.set(1.3, 1.3, 1.3);
      hovered.userData.glowSprite.material.opacity = 1.0;

      crosshair.style.borderColor = "rgba(255, 255, 255, 1)";
      crosshairDot.style.background = "rgba(255, 255, 255, 1)";

      // Create 2D ring that faces camera
      const haloMaterial = new THREE.MeshBasicMaterial({
        color: hovered.userData.originalColor,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.8,
      });

      halo = new THREE.Mesh(haloGeometry, haloMaterial);
      halo.position.copy(hovered.position);
      halo.lookAt(camera.position); // Always face camera (2D effect)
      scene.add(halo);

      console.log(`Hovering: ${hovered.userData.title}`);
    } else {
      crosshair.style.borderColor = "rgba(135, 206, 235, 0.8)";
      crosshairDot.style.background = "rgba(135, 206, 235, 0.8)";
    }
  }

  // ===============================
  // 8️⃣ SPHERE PULSE ANIMATION
  // ===============================
  function animateSpheres() {
    const time = Date.now() * 0.005;

    loadedSpheres.forEach((loaded, index) => {
      const sphere = loaded.sphere;
      const sprite = loaded.sprite;

      // Skip animation for hovered sphere
      if (hovered === sphere) return;

      // Subtle pulse
      const pulse = 1 + Math.sin(time * 2 + index * 0.1) * 0.05;
      sphere.scale.set(pulse, pulse, pulse);

      // Gentle rotation
      sphere.rotation.y += 0.005;

      // Sync glow sprite with sphere
      sprite.position.copy(sphere.position);
    });

    // Update halo to always face camera
    if (halo) {
      halo.lookAt(camera.position);
    }
  }

  // ===============================
  // 9️⃣ ANIMATION LOOP
  // ===============================
  function animate() {
    requestAnimationFrame(animate);
    movePlayer();
    updateDotLoading(); // Check distance and load/unload individual dots
    handleHover();
    animateSpheres();
    updatePerformanceDisplay(); // Update performance metrics
    updateMinimap(); // Update minimap
    renderer.render(scene, camera);
  }

  animate();

  // ===============================
  // 🔟 RESIZE HANDLER
  // ===============================
  window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>
