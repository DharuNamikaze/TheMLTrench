<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Engine-Style Chunked LOD World</title>
  <style>
    body { margin:0; overflow:hidden; background:#000; }
    #hud {
      position:fixed; top:10px; left:10px;
      color:#ff7a00; font-family:monospace;
      background:rgba(0,0,0,.7); padding:10px;
      font-size:11px; border-radius:6px;
    }
  </style>
</head>
<body>
<div id="hud"></div>

<script type="module">
import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.module.js";

////////////////////////////////////////////////////////////
// SETTINGS
////////////////////////////////////////////////////////////
const TOTAL_SPHERES = 10000;
const CHUNK_SIZE   = 4000;
const RENDER_DIST  = 8000;

const LOD_DIST = {
  HIGH: 800,
  MID:  3000,
  LOW:  8000
};

////////////////////////////////////////////////////////////
// SCENE / CAMERA / RENDERER
////////////////////////////////////////////////////////////
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x000000);

const camera = new THREE.PerspectiveCamera(60, innerWidth/innerHeight, 0.1, RENDER_DIST);
camera.position.set(0,0,200);

const renderer = new THREE.WebGLRenderer({ antialias:false, powerPreference:"high-performance" });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
document.body.appendChild(renderer.domElement);

////////////////////////////////////////////////////////////
// HUD
////////////////////////////////////////////////////////////
const hud = document.getElementById("hud");
let lastTime = performance.now(), fps = 0;

////////////////////////////////////////////////////////////
// GLOBAL GPU RESOURCES (CREATED ONCE)
////////////////////////////////////////////////////////////
const GEOMETRY = {
  HIGH: new THREE.SphereGeometry(8,16,16),
  MID:  new THREE.SphereGeometry(8,8,8),
  LOW:  new THREE.SphereGeometry(8,4,4)
};

const MATERIAL = new THREE.MeshStandardMaterial({
  color:0xffffff, transparent:true, opacity:0.95
});

scene.add(new THREE.AmbientLight(0xffffff,0.6));

////////////////////////////////////////////////////////////
// GENERATE WORLD DATA (CPU-SIDE)
////////////////////////////////////////////////////////////
const sphereData = [];
let minX=Infinity,maxX=-Infinity,minZ=Infinity,maxZ=-Infinity;

for(let i=0;i<TOTAL_SPHERES;i++){
  const p = new THREE.Vector3(
    (Math.random()-0.5)*15000,
    (Math.random()-0.5)*2000,
    (Math.random()-0.5)*15000
  );
  sphereData.push(p);
  minX=Math.min(minX,p.x); maxX=Math.max(maxX,p.x);
  minZ=Math.min(minZ,p.z); maxZ=Math.max(maxZ,p.z);
}

////////////////////////////////////////////////////////////
// BUILD CHUNKS
////////////////////////////////////////////////////////////
const chunks = new Map();
const originX=minX, originZ=minZ;

for(let i=0;i<sphereData.length;i++){
  const p=sphereData[i];
  const cx=Math.floor((p.x-originX)/CHUNK_SIZE);
  const cz=Math.floor((p.z-originZ)/CHUNK_SIZE);
  const key=`${cx},${cz}`;

  if(!chunks.has(key)){
    const min=new THREE.Vector3(
      originX+cx*CHUNK_SIZE,-2000,
      originZ+cz*CHUNK_SIZE
    );
    const max=new THREE.Vector3(
      originX+(cx+1)*CHUNK_SIZE,2000,
      originZ+(cz+1)*CHUNK_SIZE
    );
    chunks.set(key,{
      center:new THREE.Vector3(
        (min.x+max.x)/2,0,(min.z+max.z)/2
      ),
      bbox:new THREE.Box3(min,max),
      indices:[],
      lod:{},
      currentLOD:null
    });
  }
  chunks.get(key).indices.push(i);
}

////////////////////////////////////////////////////////////
// BUILD CHUNK LOD MESHES (ONCE)
////////////////////////////////////////////////////////////
const dummy=new THREE.Object3D();

for(const chunk of chunks.values()){
  for(const level of ["HIGH","MID","LOW"]){
    const mesh=new THREE.InstancedMesh(
      GEOMETRY[level], MATERIAL, chunk.indices.length
    );
    mesh.visible=false;
    mesh.frustumCulled=false;

    for(let i=0;i<chunk.indices.length;i++){
      dummy.position.copy(sphereData[chunk.indices[i]]);
      dummy.updateMatrix();
      mesh.setMatrixAt(i,dummy.matrix);
    }
    mesh.instanceMatrix.needsUpdate=true;
    scene.add(mesh);
    chunk.lod[level]=mesh;
  }
}

////////////////////////////////////////////////////////////
// FRUSTUM / LOD LOGIC
////////////////////////////////////////////////////////////
const frustum=new THREE.Frustum();
const proj=new THREE.Matrix4();

function pickLOD(d){
  if(d<LOD_DIST.HIGH) return "HIGH";
  if(d<LOD_DIST.MID)  return "MID";
  return "LOW";
}

function updateChunks(){
  proj.multiplyMatrices(camera.projectionMatrix,camera.matrixWorldInverse);
  frustum.setFromProjectionMatrix(proj);

  let visible=0;

  for(const chunk of chunks.values()){
    const inView=frustum.intersectsBox(chunk.bbox) &&
                 camera.position.distanceTo(chunk.center)<=RENDER_DIST;

    if(!inView){
      if(chunk.currentLOD){
        chunk.lod[chunk.currentLOD].visible=false;
        chunk.currentLOD=null;
      }
      continue;
    }

    const d=camera.position.distanceTo(chunk.center);
    const desired=pickLOD(d);

    if(chunk.currentLOD!==desired){
      if(chunk.currentLOD)
        chunk.lod[chunk.currentLOD].visible=false;
      chunk.lod[desired].visible=true;
      chunk.currentLOD=desired;
    }

    visible+=chunk.indices.length;
  }

  hud.innerHTML=
    `FPS: ${fps}<br>`+
    `Visible: ${visible}/${TOTAL_SPHERES}<br>`+
    `Cam: ${camera.position.x.toFixed(0)},${camera.position.y.toFixed(0)},${camera.position.z.toFixed(0)}`;
}

////////////////////////////////////////////////////////////
// MOVEMENT (SAFE)
////////////////////////////////////////////////////////////
let rotX=0,rotY=0;
const keys={};

document.body.onclick=()=>document.body.requestPointerLock();
document.addEventListener("mousemove",e=>{
  if(document.pointerLockElement!==document.body) return;
  rotY-=e.movementX*0.002;
  rotX-=e.movementY*0.002;
  rotX=Math.max(-Math.PI/2,Math.min(Math.PI/2,rotX));
  camera.rotation.order="YXZ";
  camera.rotation.set(rotX,rotY,0);
});

addEventListener("keydown",e=>keys[e.code]=true);
addEventListener("keyup",e=>keys[e.code]=false);

function move(){
  const dir=new THREE.Vector3();
  const f=new THREE.Vector3(0,0,-1).applyQuaternion(camera.quaternion);
  const r=new THREE.Vector3(1,0,0).applyQuaternion(camera.quaternion);
  if(keys.KeyW) dir.add(f);
  if(keys.KeyS) dir.sub(f);
  if(keys.KeyD) dir.add(r);
  if(keys.KeyA) dir.sub(r);
  if(dir.lengthSq()>0){
    dir.normalize();
    camera.position.addScaledVector(dir,15);
  }
}

////////////////////////////////////////////////////////////
// LOOP
////////////////////////////////////////////////////////////
function loop(){
  requestAnimationFrame(loop);
  const now=performance.now();
  fps=Math.round(1000/(now-lastTime));
  lastTime=now;

  move();
  updateChunks();
  renderer.render(scene,camera);
}
loop();

addEventListener("resize",()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>