<script is:inline type="module">
  import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.module.js";

  // Add canvas styling to prevent distortion
  const style = document.createElement('style');
  style.textContent = `
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
    canvas {
      display: block;
      width: 100vw !important;
      height: 100vh !important;
      position: fixed;
      top: 0;
      left: 0;
    }
  `;
  document.head.appendChild(style);

  // ===============================
  // 0️⃣ CROSSHAIR SETUP
  // ===============================
  const crosshair = document.createElement('div');
  crosshair.id = 'crosshair';
  crosshair.style.cssText = `
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 30px;
    height: 30px;
    border: 2px solid rgba(135, 206, 235, 0.8);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1000;
    transition: border-color 0.2s;
  `;
  
  const crosshairDot = document.createElement('div');
  crosshairDot.style.cssText = `
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 4px;
    height: 4px;
    background: rgba(135, 206, 235, 0.8);
    border-radius: 50%;
  `;
  crosshair.appendChild(crosshairDot);
  document.body.appendChild(crosshair);

  // ===============================
  // 1️⃣ SCENE SETUP
  // ===============================
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x000000);

  const camera = new THREE.PerspectiveCamera(
    60,  // Reduced FOV from 75 to 60 to reduce distortion
    window.innerWidth / window.innerHeight,
    0.1,
    5000,
  );
  camera.position.set(0, 0, 100);

  const renderer = new THREE.WebGLRenderer({ 
    antialias: true,
    alpha: false,
    powerPreference: "high-performance"
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(window.devicePixelRatio);
  document.body.appendChild(renderer.domElement);

  // ===============================
  // 2️⃣ CLUSTER COLORS (10 clusters × 100 spheres = 1000 total)
  // ===============================
  const clusterColors = [
    0x4fc3f7, // Cyan
    0xff6b9d, // Pink
    0x00ff88, // Green
    0xffd700, // Gold
    0xff4500, // Orange Red
    0x9370db, // Purple
    0x00ced1, // Dark Turquoise
    0xff1493, // Deep Pink
    0x7fff00, // Chartreuse
    0xff00ff, // Magenta
  ];

  // ===============================
  // 3️⃣ CREATE GLOWING SPHERES WITH DISTANCE-BASED LAZY LOADING
  // ===============================
  const sphereData = []; // Store all sphere metadata
  const loadedSpheres = new Map(); // Track loaded spheres by index
  const geometry = new THREE.SphereGeometry(8, 16, 16);
  const RENDER_DISTANCE = 2500; // Distance threshold for rendering individual dots

  // Performance tracking
  const performanceStats = {
    totalDots: 1000,
    loadedDots: 0,
    fps: 0,
    frameTime: 0,
    lastFrameTime: performance.now()
  };

  // Create performance display
  const perfDisplay = document.createElement('div');
  perfDisplay.style.cssText = `
    position: fixed;
    top: 10px;
    left: 10px;
    background: rgba(0, 0, 0, 0.7);
    color: #00ff88;
    padding: 15px;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    border-radius: 5px;
    z-index: 1001;
    line-height: 1.6;
    border: 1px solid rgba(0, 255, 136, 0.3);
  `;
  document.body.appendChild(perfDisplay);

  function updatePerformanceDisplay() {
    const now = performance.now();
    const delta = now - performanceStats.lastFrameTime;
    performanceStats.lastFrameTime = now;
    performanceStats.fps = Math.round(1000 / delta);
    performanceStats.frameTime = delta.toFixed(2);
    
    const memoryUsage = performance.memory ? 
      `${(performance.memory.usedJSHeapSize / 1048576).toFixed(2)} MB` : 
      'N/A';
    
    const loadPercentage = ((performanceStats.loadedDots / performanceStats.totalDots) * 100).toFixed(1);
    const memorySaved = ((1 - performanceStats.loadedDots / performanceStats.totalDots) * 100).toFixed(0);
    
    perfDisplay.innerHTML = `
      <strong>🚀 PERFORMANCE METRICS</strong><br>
      ━━━━━━━━━━━━━━━━━━━━━━<br>
      FPS: <span style="color: ${performanceStats.fps > 50 ? '#00ff88' : '#ff4500'}">${performanceStats.fps}</span><br>
      Frame Time: ${performanceStats.frameTime}ms<br>
      ━━━━━━━━━━━━━━━━━━━━━━<br>
      <strong>📦 DISTANCE-BASED LOADING</strong><br>
      Loaded Dots: ${performanceStats.loadedDots}/${performanceStats.totalDots} (${loadPercentage}%)<br>
      Memory Saved: ~${memorySaved}%<br>
      Render Distance: ${RENDER_DISTANCE} units<br>
      ━━━━━━━━━━━━━━━━━━━━━━<br>
      Memory Usage: ${memoryUsage}<br>
      Camera: (${camera.position.x.toFixed(0)}, ${camera.position.y.toFixed(0)}, ${camera.position.z.toFixed(0)})
    `;
  }

  // ===============================
  // MINIMAP SETUP - ENHANCED WHOLE-SPACE MAP
  // ===============================
  const minimapCanvas = document.createElement('canvas');
  minimapCanvas.width = 200;
  minimapCanvas.height = 200;
  minimapCanvas.style.cssText = `
    position: fixed;
    top: 20px;
    right: 20px;
    width: 200px;
    height: 200px;
    background: rgba(0, 0, 0, 0.9);
    border: 3px solid rgba(0, 255, 136, 0.7);
    border-radius: 15px;
    z-index: 1001;
    pointer-events: none;
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.5);
  `;
  document.body.appendChild(minimapCanvas);
  const minimapCtx = minimapCanvas.getContext('2d');

  // Calculate bounds of all dots for minimap scaling
  let minX = Infinity, maxX = -Infinity;
  let minY = Infinity, maxY = -Infinity;
  let minZ = Infinity, maxZ = -Infinity;

  // Note: sphereData will be populated after this section, so we'll update bounds dynamically
  function updateMinimapBounds() {
    sphereData.forEach(data => {
      minX = Math.min(minX, data.position.x);
      maxX = Math.max(maxX, data.position.x);
      minY = Math.min(minY, data.position.y);
      maxY = Math.max(maxY, data.position.y);
      minZ = Math.min(minZ, data.position.z);
      maxZ = Math.max(maxZ, data.position.z);
    });
  }

  const worldWidth = () => maxX - minX;
  const worldHeight = () => maxZ - minZ;
  const scale = () => Math.min(170 / worldWidth(), 170 / worldHeight()); // Adjusted for 200px canvas

  function updateMinimap() {
    // Clear canvas
    minimapCtx.fillStyle = 'rgba(0, 0, 0, 0.95)';
    minimapCtx.fillRect(0, 0, 200, 200);
    
    // Draw grid
    minimapCtx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
    minimapCtx.lineWidth = 1;
    for (let i = 0; i <= 200; i += 40) {
      minimapCtx.beginPath();
      minimapCtx.moveTo(i, 0);
      minimapCtx.lineTo(i, 200);
      minimapCtx.stroke();
      minimapCtx.beginPath();
      minimapCtx.moveTo(0, i);
      minimapCtx.lineTo(200, i);
      minimapCtx.stroke();
    }
    
    // Draw border
    minimapCtx.strokeStyle = 'rgba(0, 255, 136, 0.3)';
    minimapCtx.lineWidth = 2;
    minimapCtx.strokeRect(10, 25, 180, 165);
    
    // Draw all dots with cluster visualization
    sphereData.forEach(data => {
      const x = ((data.position.x - (minX + maxX) / 2) * scale()) + 100;
      const y = ((data.position.z - (minZ + maxZ) / 2) * scale()) + 100;
      
      // Draw larger dots for better visibility
      const isLoaded = loadedSpheres.has(data.index);
      minimapCtx.fillStyle = `#${data.color.toString(16).padStart(6, '0')}`;
      minimapCtx.globalAlpha = isLoaded ? 0.9 : 0.3;
      minimapCtx.beginPath();
      minimapCtx.arc(x, y, isLoaded ? 2.5 : 1.5, 0, Math.PI * 2);
      minimapCtx.fill();
    });
    
    minimapCtx.globalAlpha = 1;
    
    // Draw render distance circle
    const renderRadiusOnMap = RENDER_DISTANCE * scale();
    const camX = ((camera.position.x - (minX + maxX) / 2) * scale()) + 100;
    const camY = ((camera.position.z - (minZ + maxZ) / 2) * scale()) + 100;
    
    minimapCtx.strokeStyle = 'rgba(135, 206, 235, 0.6)';
    minimapCtx.lineWidth = 1.5;
    minimapCtx.setLineDash([4, 4]);
    minimapCtx.beginPath();
    minimapCtx.arc(camX, camY, renderRadiusOnMap, 0, Math.PI * 2);
    minimapCtx.stroke();
    minimapCtx.setLineDash([]);
    
    // Draw camera position with glow
    minimapCtx.shadowBlur = 8;
    minimapCtx.shadowColor = '#00ff88';
    minimapCtx.fillStyle = '#00ff88';
    minimapCtx.beginPath();
    minimapCtx.arc(camX, camY, 4, 0, Math.PI * 2);
    minimapCtx.fill();
    minimapCtx.shadowBlur = 0;
    
    // Draw camera direction indicator
    const dirLength = 15;
    const dirX = Math.sin(camera.rotation.y) * dirLength;
    const dirY = Math.cos(camera.rotation.y) * dirLength;
    
    minimapCtx.strokeStyle = '#00ff88';
    minimapCtx.lineWidth = 2;
    minimapCtx.beginPath();
    minimapCtx.moveTo(camX, camY);
    minimapCtx.lineTo(camX + dirX, camY - dirY);
    minimapCtx.stroke();
    
    // Draw title with background
    minimapCtx.fillStyle = 'rgba(0, 0, 0, 0.8)';
    minimapCtx.fillRect(0, 0, 200, 22);
    minimapCtx.fillStyle = '#00ff88';
    minimapCtx.font = 'bold 11px Courier New';
    minimapCtx.fillText('🗺️ SPACE MAP', 10, 15);
    
    // Draw cluster count
    minimapCtx.fillStyle = 'rgba(255, 255, 255, 0.7)';
    minimapCtx.font = '8px Courier New';
    minimapCtx.fillText(`${sphereData.length} Dots`, 130, 15);
  }

  // Create glow texture for sprites (enhanced neon glow)
  const canvas = document.createElement('canvas');
  canvas.width = 256;
  canvas.height = 256;
  const ctx = canvas.getContext('2d');
  
  // Create intense neon glow with multiple layers
  const gradient = ctx.createRadialGradient(128, 128, 0, 128, 128, 128);
  gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
  gradient.addColorStop(0.1, 'rgba(255, 255, 255, 0.9)');
  gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.7)');
  gradient.addColorStop(0.3, 'rgba(255, 255, 255, 0.5)');
  gradient.addColorStop(0.5, 'rgba(255, 255, 255, 0.3)');
  gradient.addColorStop(0.7, 'rgba(255, 255, 255, 0.15)');
  gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, 256, 256);
  const glowTexture = new THREE.CanvasTexture(canvas);

  // Generate all sphere metadata (1000 dots in 10 clusters)
  // INCREASED DISTANCE: Expanded from 7000 to 15000 for more space between clusters
  let dotIndex = 0;
  for (let clusterIndex = 0; clusterIndex < 10; clusterIndex++) {
    const clusterColor = clusterColors[clusterIndex];
    
    // Random cluster center in free space - MUCH LARGER SPREAD
    const clusterCenter = new THREE.Vector3(
      (Math.random() - 0.5) * 15000,
      (Math.random() - 0.5) * 15000,
      (Math.random() - 0.5) * 15000
    );

    // Generate 100 dots per cluster - INCREASED CLUSTER SIZE
    for (let i = 0; i < 100; i++) {
      const radius = Math.random() * 1200 + 200; // Increased from 800+100 to 1200+200
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);

      const position = new THREE.Vector3(
        clusterCenter.x + radius * Math.sin(phi) * Math.cos(theta),
        clusterCenter.y + radius * Math.sin(phi) * Math.sin(theta),
        clusterCenter.z + radius * Math.cos(phi)
      );

      sphereData.push({
        index: dotIndex++,
        position: position,
        color: clusterColor,
        cluster: clusterIndex,
        title: `Cluster ${clusterIndex + 1} - Concept ${i + 1}`,
        description: `A concept in cluster ${clusterIndex + 1}`
      });
    }
  }

  console.log(`✅ Generated ${sphereData.length} dots with metadata`);
  console.log(`📊 Distance-based loading enabled (${RENDER_DISTANCE} units)`);
  
  // Update minimap bounds after generating all sphere data
  updateMinimapBounds();

  // Function to load a single dot
  function loadDot(data) {
    if (loadedSpheres.has(data.index)) return;

    const material = new THREE.MeshBasicMaterial({
      color: data.color,
      transparent: true,
      opacity: 0.9,
    });

    const sphere = new THREE.Mesh(geometry, material);
    sphere.position.copy(data.position);

    // Add glow sprite
    const spriteMaterial = new THREE.SpriteMaterial({
      map: glowTexture,
      color: data.color,
      transparent: true,
      blending: THREE.AdditiveBlending,
      opacity: 0.5,
    });
    const sprite = new THREE.Sprite(spriteMaterial);
    sprite.scale.set(50, 50, 1);
    sprite.position.copy(data.position);
    scene.add(sprite);

    sphere.userData = {
      title: data.title,
      description: data.description,
      cluster: data.cluster,
      originalColor: data.color,
      glowSprite: sprite,
      dataIndex: data.index
    };

    scene.add(sphere);

    loadedSpheres.set(data.index, { sphere, sprite });
    performanceStats.loadedDots++;
  }

  // Function to unload a single dot
  function unloadDot(index) {
    const loaded = loadedSpheres.get(index);
    if (!loaded) return;

    scene.remove(loaded.sphere);
    scene.remove(loaded.sprite);
    loadedSpheres.delete(index);
    performanceStats.loadedDots--;
  }

  // Function to update dot loading based on camera distance
  function updateDotLoading() {
    sphereData.forEach(data => {
      const distance = camera.position.distanceTo(data.position);
      
      if (distance < RENDER_DISTANCE && !loadedSpheres.has(data.index)) {
        loadDot(data);
      } else if (distance >= RENDER_DISTANCE && loadedSpheres.has(data.index)) {
        unloadDot(data.index);
      }
    });
  }

  // Initial load of nearby dots
  updateDotLoading();

  // ===============================
  // 4️⃣ MINIMAL LIGHTING
  // ===============================
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.2);
  scene.add(ambientLight);

  // ===============================
  // 5️⃣ FREE-LOOK CAMERA WITH POINTER LOCK (NO SMOOTHING)
  // ===============================
  let rotationX = 0;
  let rotationY = 0;
  let isLocked = false;

  // Click to lock pointer
  document.body.addEventListener("click", () => {
    document.body.requestPointerLock();
  });

  document.addEventListener("pointerlockchange", () => {
    isLocked = document.pointerLockElement === document.body;
  });

  // Mouse move for free look (instant, no smoothing)
  document.addEventListener("mousemove", (e) => {
    if (!isLocked) return;
    
    // Direct rotation control (no smoothing)
    rotationY -= e.movementX * 0.002;
    rotationX -= e.movementY * 0.002;
    
    // Clamp vertical rotation to prevent flipping
    rotationX = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, rotationX));
    
    // Apply rotation using proper Euler order to prevent gimbal lock
    camera.rotation.order = 'YXZ';
    camera.rotation.y = rotationY;
    camera.rotation.x = rotationX;
  });

  // ESC to exit pointer lock
  window.addEventListener("keydown", (e) => {
    if (e.code === "Escape") {
      document.exitPointerLock();
    }
  });

  // ===============================
  // 6️⃣ KEYBOARD MOVEMENT
  // ===============================
  const keys = {};
  let speed = 8;
  let isBoosting = false;

  window.addEventListener("keydown", (e) => {
    keys[e.code] = true;
    if (e.code === "ShiftLeft") isBoosting = true;
  });

  window.addEventListener("keyup", (e) => {
    keys[e.code] = false;
    if (e.code === "ShiftLeft") isBoosting = false;
  });

  function movePlayer() {
    const move = new THREE.Vector3();
    const forward = new THREE.Vector3(0, 0, -1);
    const right = new THREE.Vector3(1, 0, 0);
    
    // Apply camera rotation to movement vectors
    forward.applyQuaternion(camera.quaternion);
    right.applyQuaternion(camera.quaternion);

    if (keys["KeyW"]) move.add(forward);
    if (keys["KeyS"]) move.sub(forward);
    if (keys["KeyD"]) move.add(right);
    if (keys["KeyA"]) move.sub(right);

    move.normalize();

    const currentSpeed = isBoosting ? speed * 6 : speed;
    camera.position.addScaledVector(move, currentSpeed);
  }

  // ===============================
  // 7️⃣ RAYCAST INTERACTION WITH 2D RING
  // ===============================
  const raycaster = new THREE.Raycaster();
  raycaster.far = 500;
  let hovered = null;
  let halo = null;

  const centerMouse = new THREE.Vector2(0, 0);
  
  // Create 2D ring geometry that always faces camera
  const haloGeometry = new THREE.RingGeometry(15, 20, 32);

  function handleHover() {
    // Get all currently loaded spheres
    const loadedSpheresArray = Array.from(loadedSpheres.values()).map(item => item.sphere);
    
    raycaster.setFromCamera(centerMouse, camera);
    const hits = raycaster.intersectObjects(loadedSpheresArray);

    // Reset previous hover
    if (hovered) {
      hovered.material.color.setHex(hovered.userData.originalColor);
      hovered.material.opacity = 0.9;
      hovered.scale.set(1, 1, 1);
      hovered.userData.glowSprite.material.opacity = 0.5;
      hovered = null;
      
      // Remove halo
      if (halo) {
        scene.remove(halo);
        halo = null;
      }
    }

    // Apply new hover
    if (hits.length > 0) {
      hovered = hits[0].object;

      // Brighten sphere
      hovered.material.color.set(0xffffff);
      hovered.material.opacity = 1.0;
      hovered.scale.set(1.3, 1.3, 1.3);
      hovered.userData.glowSprite.material.opacity = 1.0;

      crosshair.style.borderColor = 'rgba(255, 255, 255, 1)';
      crosshairDot.style.background = 'rgba(255, 255, 255, 1)';
      
      // Create 2D ring that faces camera
      const haloMaterial = new THREE.MeshBasicMaterial({
        color: hovered.userData.originalColor,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.8,
      });
      
      halo = new THREE.Mesh(haloGeometry, haloMaterial);
      halo.position.copy(hovered.position);
      halo.lookAt(camera.position); // Always face camera (2D effect)
      scene.add(halo);
      
      console.log(`Hovering: ${hovered.userData.title}`);
    } else {
      crosshair.style.borderColor = 'rgba(135, 206, 235, 0.8)';
      crosshairDot.style.background = 'rgba(135, 206, 235, 0.8)';
    }
  }

  // ===============================
  // 8️⃣ SPHERE PULSE ANIMATION
  // ===============================
  function animateSpheres() {
    const time = Date.now() * 0.005;

    loadedSpheres.forEach((loaded, index) => {
      const sphere = loaded.sphere;
      const sprite = loaded.sprite;
      
      // Skip animation for hovered sphere
      if (hovered === sphere) return;

      // Subtle pulse
      const pulse = 1 + Math.sin(time * 2 + index * 0.1) * 0.05;
      sphere.scale.set(pulse, pulse, pulse);

      // Gentle rotation
      sphere.rotation.y += 0.005;
      
      // Sync glow sprite with sphere
      sprite.position.copy(sphere.position);
    });
    
    // Update halo to always face camera
    if (halo) {
      halo.lookAt(camera.position);
    }
  }

  // ===============================
  // 9️⃣ ANIMATION LOOP
  // ===============================
  function animate() {
    requestAnimationFrame(animate);
    movePlayer();
    updateDotLoading(); // Check distance and load/unload individual dots
    handleHover();
    animateSpheres();
    updatePerformanceDisplay(); // Update performance metrics
    updateMinimap(); // Update minimap
    renderer.render(scene, camera);
  }

  animate();

  // ===============================
  // 🔟 RESIZE HANDLER
  // ===============================
  window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>