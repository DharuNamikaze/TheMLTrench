<script type="module">
  import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.module.js";

  // ===============================
  // 1️⃣ SCENE SETUP
  // ===============================
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x000428);
  scene.fog = new THREE.Fog(0x000000, 100, 1200);

  const camera = new THREE.PerspectiveCamera(
    75,
    window.innerWidth / window.innerHeight,
    0.1,
    5000,
  );
  camera.position.set(0, 0, 100);

  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  document.body.appendChild(renderer.domElement);

  // ===============================
  // 2️⃣ LIGHT
  // ===============================
  scene.add(new THREE.AmbientLight(0xffffff, 0.3));
  const light = new THREE.PointLight(0x23aeee, 2, 3000);
  scene.add(light);

  // ===============================
  // 3️⃣ CREATE SPHERES
  // ===============================
  const geometry = new THREE.SphereGeometry(15, 16, 16);
  const spheres = [];

  for (let i = 0; i < 100; i++) {
    const sphere = new THREE.Mesh(
      geometry,
      new THREE.MeshBasicMaterial({ color: 0x87ceeb }),
    );

    sphere.position.set(
      Math.random() * 2400 - 600,
      Math.random() * 1200 - 600,
      Math.random() * 2400 - 600,
    );

    sphere.userData = {
      title: `Concept ${i + 1}`,
      description: `Explore concept ${i + 1}`,
    };

    scene.add(sphere);
    spheres.push(sphere);
  }

  // ===============================
  // 4️⃣ POINTER LOCK (MOUSE LOOK)
  // ===============================
  const yaw = new THREE.Object3D();
  const pitch = new THREE.Object3D();

  yaw.add(pitch);
  pitch.add(camera);
  scene.add(yaw);

  let isLocked = false;

  document.body.addEventListener("click", () => {
    document.body.requestPointerLock();
  });

  document.addEventListener("pointerlockchange", () => {
    isLocked = document.pointerLockElement === document.body;
  });

  document.addEventListener("mousemove", (e) => {
    if (!isLocked) return;

    yaw.rotation.y -= e.movementX * 0.002;
    pitch.rotation.x -= e.movementY * 0.002;

    // Prevent flipping
    pitch.rotation.x = Math.max(
      -Math.PI / 2,
      Math.min(Math.PI / 2, pitch.rotation.x),
    );
  });

  // ===============================
  // 5️⃣ KEYBOARD MOVEMENT
  // ===============================
  const keys = {};
  let speed = 5;
  let isBoosting = false;

  window.addEventListener("keydown", (e) => {
    keys[e.code] = true;
    if (e.code === "ShiftLeft") isBoosting = true;
  });

  window.addEventListener("keyup", (e) => {
    keys[e.code] = false;
    if (e.code === "ShiftLeft") isBoosting = false;
  });

  function movePlayer() {
    const move = new THREE.Vector3();
    const forward = new THREE.Vector3();
    camera.getWorldDirection(forward);

    const right = new THREE.Vector3();
    right.crossVectors(forward, camera.up).normalize();

    const left = new THREE.Vector3();
    left.crossVectors(camera.up, forward).normalize();

    if (keys["KeyW"]) move.add(forward);
    if (keys["KeyS"]) move.sub(forward);
    if (keys["KeyA"]) move.add(left);
    if (keys["KeyD"]) move.add(right);

    move.normalize();

    const currentSpeed = isBoosting ? speed*speed: speed;
    yaw.position.addScaledVector(move, currentSpeed);
  }

  // ===============================
  // 6️⃣ RAYCAST INTERACTION
  // ===============================
  const raycaster = new THREE.Raycaster();
  const mouse = new THREE.Vector2();
  let hovered = null;

  window.addEventListener("mousemove", (e) => {
    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
  });

  function handleHover() {
    raycaster.setFromCamera(mouse, camera);
    const hits = raycaster.intersectObjects(spheres);

    if (hovered) {
      hovered.material.color.set(0x87ceeb);
      hovered.scale.set(1, 1, 1);
      hovered = null;
    }

    if (hits.length > 0) {
      hovered = hits[0].object;
      hovered.material.color.set(0xff4444);
      hovered.scale.set(1.4, 1.4, 1.4);
    }
  }

  // ===============================
  // 7️⃣ ANIMATION LOOP
  // ===============================
  function animate() {
    requestAnimationFrame(animate);
    movePlayer();
    handleHover();
    renderer.render(scene, camera);
  }

  animate();

  // ===============================
  // 8️⃣ RESIZE
  // ===============================
  window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>
